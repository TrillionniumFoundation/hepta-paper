[
  {
    "name": "pending live prepare approval is not executable",
    "action": "live_prepare",
    "policy": "prepare-allowed",
    "approved": false,
    "expectedApprovalStatus": "pending_approval",
    "expectedDecision": "blocked",
    "expectedBlockers": ["approval_not_granted"]
  },
  {
    "name": "approved live prepare packet with fresh evidence can execute",
    "action": "live_prepare",
    "policy": "prepare-allowed",
    "approved": true,
    "expectedApprovalStatus": "approved",
    "expectedDecision": "allow",
    "expectedBlockers": []
  },
  {
    "name": "approved submit packet binds prepare evidence and duplicate preflight",
    "action": "live_submit",
    "policy": "submit-allowed",
    "approved": true,
    "prepareEvidence": {
      "ok": true,
      "filenames": ["example-01.png", "example-02.png"]
    },
    "duplicatePreflight": {
      "ok": true,
      "totalMyWorks": 0
    },
    "expectedApprovalStatus": "approved",
    "expectedDecision": "allow",
    "expectedBlockers": []
  },
  {
    "name": "approved submit packet blocks duplicate existing work",
    "action": "live_submit",
    "policy": "submit-allowed",
    "approved": true,
    "prepareEvidence": {
      "ok": true,
      "filenames": ["example-01.png", "example-02.png"]
    },
    "duplicatePreflight": {
      "ok": true,
      "totalMyWorks": 1
    },
    "expectedApprovalStatus": "approved",
    "expectedDecision": "blocked",
    "expectedBlockers": ["duplicate_existing_my_works"]
  },
  {
    "name": "fresh evidence must match approval hash",
    "action": "live_prepare",
    "policy": "prepare-allowed",
    "approved": true,
    "tamperEvidenceApprovalHash": "sha256:stale",
    "expectedApprovalStatus": "approved",
    "expectedDecision": "blocked",
    "expectedBlockers": ["evidence_approval_mismatch"]
  }
]
