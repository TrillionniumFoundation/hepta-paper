[
  {
    "name": "zbj and epwk audit archive ready",
    "auditBundleFixtures": [
      "zbj inbox-chain audit bundle verified",
      "epwk inbox-chain audit bundle verified"
    ],
    "expectedStatus": "ready_external_action_audit_archive",
    "expectedBlockers": []
  },
  {
    "name": "archive blocks raw legacy bundle",
    "auditBundleFixtures": ["raw ledger cannot become final audit bundle"],
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["audit_bundle_not_verified"]
  },
  {
    "name": "archive blocks duplicate bundle hash",
    "auditBundleFixtures": ["zbj inbox-chain audit bundle verified"],
    "duplicateFirstBundle": true,
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["duplicate_audit_bundle_hash", "duplicate_ledger_hash"]
  },
  {
    "name": "archive blocks tampered bundle hash",
    "auditBundleFixtures": ["zbj inbox-chain audit bundle verified"],
    "tamperFirstBundleLedgerHash": true,
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["audit_bundle_hash_content_mismatch"]
  },
  {
    "name": "archive blocks missing bundle hash alias",
    "auditBundleFixtures": ["zbj inbox-chain audit bundle verified"],
    "dropFirstBundleHashAlias": true,
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["audit_bundle_hash_alias_required"]
  },
  {
    "name": "archive blocks missing inbox chain when verification relaxed",
    "auditBundleFixtures": ["raw ledger cannot become final audit bundle"],
    "requireVerifiedBundles": false,
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["bundle_inbox_chain_required"]
  },
  {
    "name": "empty archive blocked",
    "auditBundleFixtures": [],
    "expectedStatus": "blocked_external_action_audit_archive",
    "expectedBlockers": ["no_audit_bundles"]
  }
]
