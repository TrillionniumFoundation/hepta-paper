{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hepta-paper/node-rust-route-acceptance-v1",
  "title": "Current-subject local read-only command behavior record",
  "description": "The independent consumer must rebuild and replay the ordinary Node/Rust command matrix. Schema validation alone grants no acceptance or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "scope", "subject", "runtime", "authority", "rows", "recordSha256"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "NodeRustRouteAcceptanceRecordV1" },
    "scope": { "const": "local-readonly-command-behavior-no-external-authority" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "committedClean"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "committedClean": { "const": true }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["productionActivation", "targetHostQualification", "releaseAuthority", "submissionAuthority", "writerCutover", "nodeRetirement"],
      "properties": {
        "productionActivation": { "const": false }, "targetHostQualification": { "const": false },
        "releaseAuthority": { "const": false }, "submissionAuthority": { "const": false },
        "writerCutover": { "const": false }, "nodeRetirement": { "const": false }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "cargoVersion", "buildArgs", "nativeOwners"],
      "properties": {
        "node": {
          "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
          "properties": { "version": { "const": "v22.23.1" }, "sha256": { "$ref": "#/$defs/hash" } }
        },
        "cargoVersion": { "type": "string", "pattern": "^cargo 1\\.98\\.0\\b" },
        "buildArgs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } },
        "nativeOwners": {
          "type": "object", "additionalProperties": false, "required": ["hepta-paper-rust"],
          "properties": { "hepta-paper-rust": {
            "type": "object", "additionalProperties": false, "required": ["sha256"],
            "properties": { "sha256": { "$ref": "#/$defs/hash" } }
          } }
        }
      }
    },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["routeId", "argumentContractSha256", "behaviorContractSha256", "cases"],
        "properties": {
          "routeId": { "enum": ["operator/workspace", "verify/repository-assets"] },
          "argumentContractSha256": { "$ref": "#/$defs/hash" },
          "behaviorContractSha256": { "$ref": "#/$defs/hash" },
          "cases": {
            "type": "array", "minItems": 1, "maxItems": 200,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["caseId", "inputSha256", "nodeArgv", "nativeArgv", "environment", "node", "native", "retry", "effectsUnchanged", "passed"],
              "properties": {
                "caseId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "inputSha256": { "$ref": "#/$defs/hash" },
                "nodeArgv": { "$ref": "#/$defs/argv" }, "nativeArgv": { "$ref": "#/$defs/argv" },
                "environment": { "type": "object", "maxProperties": 3, "additionalProperties": { "type": "string" } },
                "node": { "$ref": "#/$defs/outcome" }, "native": { "$ref": "#/$defs/outcome" },
                "retry": {
                  "oneOf": [ { "type": "null" }, {
                    "type": "object", "additionalProperties": false, "required": ["node", "native", "effectsUnchanged"],
                    "properties": { "node": { "$ref": "#/$defs/outcome" }, "native": { "$ref": "#/$defs/outcome" }, "effectsUnchanged": { "const": true } }
                  } ]
                },
                "effectsUnchanged": { "const": true }, "passed": { "const": true }
              }
            }
          }
        }
      }
    },
    "recordSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 2048 } },
    "outcome": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["outcome", "exitCode", "stdout", "diagnostic"],
          "properties": { "outcome": { "const": "report" }, "exitCode": { "enum": [0, 1, 2] },
            "stdout": { "type": "object" }, "diagnostic": { "type": ["string", "null"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["outcome", "exitCode", "error", "stdout"],
          "properties": { "outcome": { "const": "refusal" }, "exitCode": { "enum": [1, 2] },
            "error": { "type": "string", "minLength": 1 }, "stdout": { "type": "null" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["outcome", "exitCode", "signal", "stdout"],
          "properties": { "outcome": { "const": "unknown-result" }, "exitCode": { "type": "null" },
            "signal": { "enum": ["SIGTERM", "SIGKILL"] }, "stdout": { "type": "null" } }
        }
      ]
    }
  }
}
