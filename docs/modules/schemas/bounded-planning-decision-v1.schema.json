{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundedPlanningDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "observedAt",
    "snapshotRequestHash",
    "stateSnapshotHash",
    "planningRequestHash",
    "candidateSetHash",
    "selectionRequestHash",
    "planSelectionHash",
    "selectedCandidateIds",
    "expiresAt",
    "authority",
    "snapshot",
    "frontier",
    "selection",
    "planningDecisionHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "BoundedPlanningDecisionV1" },
    "status": {
      "enum": ["optimal", "infeasible", "bounded_feasible", "bounded_no_incumbent"]
    },
    "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "snapshotRequestHash": { "$ref": "#/$defs/hash" },
    "stateSnapshotHash": { "$ref": "#/$defs/hash" },
    "planningRequestHash": { "$ref": "#/$defs/hash" },
    "candidateSetHash": { "$ref": "#/$defs/hash" },
    "selectionRequestHash": { "$ref": "#/$defs/hash" },
    "planSelectionHash": { "$ref": "#/$defs/hash" },
    "selectedCandidateIds": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      ]
    },
    "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized",
        "providerAuthorized",
        "executionAuthorized",
        "writerAuthorityGranted",
        "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "providerAuthorized": { "const": false },
        "executionAuthorized": { "const": false },
        "writerAuthorityGranted": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["kind", "snapshotRequestHash", "stateSnapshotHash", "expiresAt"],
      "properties": {
        "kind": { "const": "PlanningStateSnapshotV1" },
        "snapshotRequestHash": { "$ref": "#/$defs/hash" },
        "stateSnapshotHash": { "$ref": "#/$defs/hash" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "frontier": {
      "type": "object",
      "required": ["kind", "status", "planningRequestHash", "stateSnapshotHash", "candidateSetHash", "expiresAt"],
      "properties": {
        "kind": { "const": "CandidateFrontierV1" },
        "status": { "enum": ["complete", "empty"] },
        "planningRequestHash": { "$ref": "#/$defs/hash" },
        "stateSnapshotHash": { "$ref": "#/$defs/hash" },
        "candidateSetHash": { "$ref": "#/$defs/hash" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "kind", "status", "selectionRequestHash", "stateSnapshotHash",
        "candidateSetHash", "selectedCandidateIds", "planSelectionHash"
      ],
      "properties": {
        "kind": { "const": "BoundedGlobalPlanSelectionV1" },
        "status": {
          "enum": ["optimal", "infeasible", "bounded_feasible", "bounded_no_incumbent"]
        },
        "selectionRequestHash": { "$ref": "#/$defs/hash" },
        "stateSnapshotHash": { "$ref": "#/$defs/hash" },
        "candidateSetHash": { "$ref": "#/$defs/hash" },
        "selectedCandidateIds": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "maxItems": 4096, "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" } }
          ]
        },
        "planSelectionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "planningDecisionHash": { "$ref": "#/$defs/hash" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "optimal" },
        "selectedCandidateIds": { "type": "array" },
        "selection": {
          "properties": {
            "status": { "const": "optimal" },
            "selectedCandidateIds": { "type": "array" }
          }
        }
      }
    },
    {
      "properties": {
        "status": { "const": "bounded_feasible" },
        "selectedCandidateIds": { "type": "array" },
        "selection": {
          "properties": {
            "status": { "const": "bounded_feasible" },
            "selectedCandidateIds": { "type": "array" }
          }
        }
      }
    },
    {
      "properties": {
        "status": { "const": "infeasible" },
        "selectedCandidateIds": { "type": "null" },
        "selection": {
          "properties": {
            "status": { "const": "infeasible" },
            "selectedCandidateIds": { "type": "null" }
          }
        }
      }
    },
    {
      "properties": {
        "status": { "const": "bounded_no_incumbent" },
        "selectedCandidateIds": { "type": "null" },
        "selection": {
          "properties": {
            "status": { "const": "bounded_no_incumbent" },
            "selectedCandidateIds": { "type": "null" }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    }
  }
}
