{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateFrontierV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "planningRequestId",
    "planningRequestHash",
    "stateSnapshotHash",
    "capabilityId",
    "hardConstraintSetHash",
    "objectiveVersion",
    "resourcePriceSnapshotHash",
    "moduleBindingSetHash",
    "candidateCount",
    "duplicateCount",
    "candidates",
    "emptyReason",
    "expiresAt",
    "dominanceReductionApplied",
    "authority",
    "candidateSetHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "CandidateFrontierV1" },
    "status": { "enum": ["complete", "empty"] },
    "planningRequestId": { "$ref": "#/$defs/identifier" },
    "planningRequestHash": { "$ref": "#/$defs/hash" },
    "stateSnapshotHash": { "$ref": "#/$defs/hash" },
    "capabilityId": { "$ref": "#/$defs/identifier" },
    "hardConstraintSetHash": { "$ref": "#/$defs/hash" },
    "objectiveVersion": { "$ref": "#/$defs/identifier" },
    "resourcePriceSnapshotHash": { "$ref": "#/$defs/hash" },
    "moduleBindingSetHash": { "$ref": "#/$defs/hash" },
    "candidateCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "duplicateCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "candidates": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/actionCandidate" }
    },
    "emptyReason": { "type": ["string", "null"], "maxLength": 256 },
    "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "dominanceReductionApplied": { "const": false },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized",
        "providerAuthorized",
        "writerAuthorityGranted",
        "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "providerAuthorized": { "const": false },
        "writerAuthorityGranted": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    },
    "candidateSetHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "semanticSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 65536 }
    },
    "resourceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuUnits", "gpuUnits", "memoryMiB", "storageBytes"],
      "properties": {
        "cpuUnits": { "type": "number", "minimum": 0 },
        "gpuUnits": { "type": "number", "minimum": 0 },
        "memoryMiB": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "storageBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "tokenCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maximumCostMicrousd": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "actionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "candidateId",
        "planningRequestId",
        "stateSnapshotHash",
        "moduleId",
        "moduleVersion",
        "capabilityId",
        "resourceVector",
        "duration",
        "cost",
        "value",
        "risk",
        "preconditions",
        "dependencyEffects",
        "sideEffectClass",
        "irreversibleBoundary",
        "rollbackClass",
        "expiresAt",
        "inputSchema",
        "outputSchema",
        "singletonReason",
        "candidatePayloadHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "ActionCandidateV1" },
        "candidateId": { "$ref": "#/$defs/identifier" },
        "planningRequestId": { "$ref": "#/$defs/identifier" },
        "stateSnapshotHash": { "$ref": "#/$defs/hash" },
        "moduleId": { "$ref": "#/$defs/identifier" },
        "moduleVersion": { "$ref": "#/$defs/identifier" },
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "resourceVector": { "$ref": "#/$defs/resourceVector" },
        "duration": { "type": "object" },
        "cost": { "type": "object" },
        "value": { "type": "object" },
        "risk": { "type": "object" },
        "preconditions": { "$ref": "#/$defs/semanticSet" },
        "dependencyEffects": { "$ref": "#/$defs/semanticSet" },
        "sideEffectClass": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "irreversibleBoundary": { "type": ["string", "null"], "maxLength": 4096 },
        "rollbackClass": { "$ref": "#/$defs/identifier" },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "inputSchema": { "type": ["string", "null"], "maxLength": 4096 },
        "outputSchema": { "type": ["string", "null"], "maxLength": 4096 },
        "singletonReason": { "type": ["string", "null"], "maxLength": 256 },
        "candidatePayloadHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
