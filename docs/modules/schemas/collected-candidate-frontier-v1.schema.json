{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectedCandidateFrontierV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "planningRequestHash",
    "moduleBindingSetHash",
    "producerCount",
    "producerResponseHashes",
    "rawCandidateCount",
    "candidateSetHash",
    "authority",
    "producerReceipts",
    "frontier",
    "collectionHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "CollectedCandidateFrontierV1" },
    "status": { "const": "complete" },
    "planningRequestHash": { "$ref": "#/$defs/hash" },
    "moduleBindingSetHash": { "$ref": "#/$defs/hash" },
    "producerCount": { "type": "integer", "minimum": 1, "maximum": 256 },
    "producerResponseHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/hash" }
    },
    "rawCandidateCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "candidateSetHash": { "$ref": "#/$defs/hash" },
    "authority": { "$ref": "#/$defs/authority" },
    "producerReceipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/producerReceipt" }
    },
    "frontier": {
      "type": "object",
      "required": [
        "schemaVersion", "kind", "status", "planningRequestHash",
        "moduleBindingSetHash", "candidateCount", "candidateSetHash", "authority"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "CandidateFrontierV1" },
        "status": { "enum": ["complete", "empty"] },
        "planningRequestHash": { "$ref": "#/$defs/hash" },
        "moduleBindingSetHash": { "$ref": "#/$defs/hash" },
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "candidateSetHash": { "$ref": "#/$defs/hash" },
        "authority": { "$ref": "#/$defs/authority" }
      }
    },
    "collectionHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized", "providerAuthorized",
        "writerAuthorityGranted", "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "providerAuthorized": { "const": false },
        "writerAuthorityGranted": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    },
    "producerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "kind", "status", "moduleId", "moduleVersion",
        "planningRequestHash", "candidateCount", "candidatePayloadHashes",
        "emptyReason", "authority", "responseHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "ModuleCandidateResponseV1" },
        "status": { "const": "complete" },
        "moduleId": { "$ref": "#/$defs/identifier" },
        "moduleVersion": { "$ref": "#/$defs/identifier" },
        "planningRequestHash": { "$ref": "#/$defs/hash" },
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "candidatePayloadHashes": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/hash" }
        },
        "emptyReason": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        },
        "authority": { "$ref": "#/$defs/authority" },
        "responseHash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": { "properties": { "candidateCount": { "const": 0 } } },
          "then": { "properties": { "emptyReason": { "type": "string" } } },
          "else": { "properties": { "emptyReason": { "type": "null" } } }
        }
      ]
    }
  }
}
