{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectedPlanningStateSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "status", "snapshotRequestHash",
    "readTransactionHash", "consistencyEpoch", "componentCount",
    "componentPayloadHashes", "stateSnapshotHash", "sessionClosed",
    "authority", "snapshot", "collectionHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "CollectedPlanningStateSnapshotV1" },
    "status": { "const": "complete" },
    "snapshotRequestHash": { "$ref": "#/$defs/hash" },
    "readTransactionHash": { "$ref": "#/$defs/hash" },
    "consistencyEpoch": { "$ref": "#/$defs/nonnegativeSafeInteger" },
    "componentCount": { "type": "integer", "minimum": 1, "maximum": 256 },
    "componentPayloadHashes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": { "$ref": "#/$defs/hash" }
    },
    "stateSnapshotHash": { "$ref": "#/$defs/hash" },
    "sessionClosed": { "const": true },
    "authority": { "$ref": "#/$defs/authority" },
    "snapshot": {
      "type": "object",
      "required": [
        "schemaVersion", "kind", "status", "snapshotRequestHash",
        "readTransactionHash", "consistencyEpoch", "componentCount",
        "components", "expiresAt", "authority", "stateSnapshotHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "PlanningStateSnapshotV1" },
        "status": { "const": "complete" },
        "snapshotRequestHash": { "$ref": "#/$defs/hash" },
        "readTransactionHash": { "$ref": "#/$defs/hash" },
        "consistencyEpoch": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "componentCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "components": { "type": "array", "minItems": 1, "maxItems": 256 },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "authority": { "$ref": "#/$defs/authority" },
        "stateSnapshotHash": { "$ref": "#/$defs/hash" }
      }
    },
    "collectionHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegativeSafeInteger": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740991
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized", "writerAuthorityGranted",
        "providerAuthorized", "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "writerAuthorityGranted": { "const": false },
        "providerAuthorized": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    }
  }
}
