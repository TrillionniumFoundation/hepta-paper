{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalPlanSelectionRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "selectionRequestId",
    "planningRequestHash",
    "stateSnapshotHash",
    "candidateSetHash",
    "hardConstraintSetHash",
    "objectiveVersion",
    "resourcePriceSnapshotHash",
    "deadline",
    "expansionBudget",
    "maximumSelectedCandidates",
    "resourceLimits",
    "requiredCandidateIds",
    "evaluations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "GlobalPlanSelectionRequestV1" },
    "selectionRequestId": { "$ref": "#/$defs/identifier" },
    "planningRequestHash": { "$ref": "#/$defs/hash" },
    "stateSnapshotHash": { "$ref": "#/$defs/hash" },
    "candidateSetHash": { "$ref": "#/$defs/hash" },
    "hardConstraintSetHash": { "$ref": "#/$defs/hash" },
    "objectiveVersion": { "$ref": "#/$defs/identifier" },
    "resourcePriceSnapshotHash": { "$ref": "#/$defs/hash" },
    "deadline": { "type": "string", "format": "date-time", "maxLength": 64 },
    "expansionBudget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "maximumSelectedCandidates": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "resourceLimits": { "$ref": "#/$defs/resourceVector" },
    "requiredCandidateIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "evaluations": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/evaluation" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "resourceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuMilliunits",
        "gpuMilliunits",
        "memoryMiB",
        "storageBytes",
        "tokenCount",
        "maximumCostMicrousd"
      ],
      "properties": {
        "cpuMilliunits": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "gpuMilliunits": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "memoryMiB": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "storageBytes": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "tokenCount": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "maximumCostMicrousd": { "$ref": "#/$defs/nonnegativeSafeInteger" }
      }
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidatePayloadHash",
        "utilityMicrounits",
        "dependencies",
        "mutexGroup"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/identifier" },
        "candidatePayloadHash": { "$ref": "#/$defs/hash" },
        "utilityMicrounits": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "dependencies": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "mutexGroup": {
          "type": ["string", "null"],
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        }
      }
    }
  }
}
