{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stateDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          },
          "definitionHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "stateDirectory",
          "definitionHash"
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "workflows"
  ]
}
