{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleDocumentationIndexV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","kind","registryPath","specificationTemplate","requiredSections","modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ModuleDocumentationIndexV1"},
    "registryPath": {"const": "docs/system/truth/modules.v1.json"},
    "specificationTemplate": {"const": "docs/modules/MODULE_TEMPLATE.md"},
    "requiredSections": {"type":"array","minItems":15,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "modules": {
      "type":"object",
      "minProperties":1,
      "propertyNames":{"pattern":"^module\\.[a-z0-9-]+$"},
      "additionalProperties": {
        "type":"object",
        "additionalProperties":false,
        "required":["specPath","manifestPath","documentationStatus"],
        "properties": {
          "specPath":{"type":"string","pattern":"^docs/modules/specs/[a-z0-9-]+\\.md$"},
          "manifestPath":{"type":"string","pattern":"^docs/modules/manifests/[a-z0-9-]+\\.v1\\.json$"},
          "documentationStatus":{"const":"complete"}
        }
      }
    }
  }
}
