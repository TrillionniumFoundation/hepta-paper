{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningSnapshotComponentResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "status", "component", "authority"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "PlanningSnapshotComponentResponseV1" },
    "status": { "const": "complete" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "kind", "componentId", "componentKind",
        "sourceModuleId", "sourceModuleVersion", "sourceQualificationHash",
        "readTransactionHash", "consistencyEpoch", "revision", "generation",
        "capturedAt", "expiresAt", "payload", "componentPayloadHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "PlanningSnapshotComponentV1" },
        "componentId": { "$ref": "#/$defs/identifier" },
        "componentKind": { "$ref": "#/$defs/identifier" },
        "sourceModuleId": { "$ref": "#/$defs/identifier" },
        "sourceModuleVersion": { "$ref": "#/$defs/identifier" },
        "sourceQualificationHash": { "$ref": "#/$defs/hash" },
        "readTransactionHash": { "$ref": "#/$defs/hash" },
        "consistencyEpoch": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "revision": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "generation": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "capturedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "payload": {},
        "componentPayloadHash": { "$ref": "#/$defs/hash" }
      }
    },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "nonnegativeSafeInteger": {
      "type": "integer", "minimum": 0, "maximum": 9007199254740991
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized", "writerAuthorityGranted",
        "providerAuthorized", "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "writerAuthorityGranted": { "const": false },
        "providerAuthorized": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    }
  }
}
