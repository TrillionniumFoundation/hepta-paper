{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualifiedModuleBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleId",
    "moduleVersion",
    "capabilityIds",
    "qualificationSubjectHash",
    "validUntil"
  ],
  "properties": {
    "moduleId": { "$ref": "#/$defs/identifier" },
    "moduleVersion": { "$ref": "#/$defs/identifier" },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "qualificationSubjectHash": { "$ref": "#/$defs/hash" },
    "validUntil": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    }
  }
}
