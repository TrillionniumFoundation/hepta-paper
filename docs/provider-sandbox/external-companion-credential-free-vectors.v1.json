{
  "version": 1,
  "kind": "ProviderExternalCompanionCredentialFreeVectorsV1",
  "status": "credential_free_vectors_non_authorizing",
  "protocolVersion": "provider-technical-sandbox-v1",
  "positive": [
    {
      "id": "bounded-opaque-identities",
      "request": {
        "environment": "provider_sandbox",
        "provider": "credential-free-control",
        "accountId": "no-account-authority",
        "paperId": "acceptance-vector-bounded",
        "dispatchAuthorizationHash": "sha256:dispatch-control",
        "packageHash": "sha256:sandbox-package",
        "liveActionAllowed": false
      },
      "expectedResponse": {
        "kind": "ProviderTechnicalSandboxResponseV1",
        "status": "technical_sandbox_response_incomplete_for_external_acceptance",
        "companionVersion": "provider-technical-sandbox-v1",
        "providerReceiptSandbox": true,
        "credentialsObserved": false,
        "networkActionPerformed": false,
        "externalActionPerformed": false,
        "productionEligible": false,
        "externalAuthorityClaimed": false
      }
    },
    {
      "id": "hex-digest-identities",
      "request": {
        "environment": "provider_sandbox",
        "provider": "credential-free-control",
        "accountId": "no-account-authority",
        "paperId": "acceptance-vector-hex",
        "dispatchAuthorizationHash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "packageHash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "liveActionAllowed": false
      },
      "expectedResponse": {
        "kind": "ProviderTechnicalSandboxResponseV1",
        "status": "technical_sandbox_response_incomplete_for_external_acceptance",
        "companionVersion": "provider-technical-sandbox-v1",
        "providerReceiptSandbox": true,
        "credentialsObserved": false,
        "networkActionPerformed": false,
        "externalActionPerformed": false,
        "productionEligible": false,
        "externalAuthorityClaimed": false
      }
    }
  ],
  "negative": [
    {
      "id": "duplicate-decoded-key",
      "requestText": "{\"environment\":\"provider_sandbox\",\"provider\":\"first\",\"provider\":\"second\",\"accountId\":\"none\",\"paperId\":\"duplicate\",\"dispatchAuthorizationHash\":\"sha256:dispatch-control\",\"packageHash\":\"sha256:sandbox-package\",\"liveActionAllowed\":false}",
      "expectedError": "provider_sandbox_request_duplicate_key",
      "expectedOutputCreated": false
    },
    {
      "id": "live-action-forbidden",
      "requestText": "{\"environment\":\"provider_sandbox\",\"provider\":\"control\",\"accountId\":\"none\",\"paperId\":\"live-action\",\"dispatchAuthorizationHash\":\"sha256:dispatch-control\",\"packageHash\":\"sha256:sandbox-package\",\"liveActionAllowed\":true}",
      "expectedError": "provider_sandbox_live_action_forbidden",
      "expectedOutputCreated": false
    },
    {
      "id": "terminal-control-identity",
      "requestText": "{\"environment\":\"provider_sandbox\",\"provider\":\"control\",\"accountId\":\"none\",\"paperId\":\"terminal\",\"dispatchAuthorizationHash\":\"sha256:dispatch-control\",\"packageHash\":\"sha256:sandbox-package\\n\",\"liveActionAllowed\":false}",
      "expectedError": "provider_sandbox_package_hash_invalid",
      "expectedOutputCreated": false
    },
    {
      "id": "unknown-credential-field",
      "requestText": "{\"environment\":\"provider_sandbox\",\"provider\":\"control\",\"accountId\":\"none\",\"paperId\":\"credential-field\",\"dispatchAuthorizationHash\":\"sha256:dispatch-control\",\"packageHash\":\"sha256:sandbox-package\",\"liveActionAllowed\":false,\"credential\":\"forbidden\"}",
      "expectedError": "provider_sandbox_request_invalid",
      "expectedOutputCreated": false
    }
  ],
  "authority": {
    "externalAuthorityClaimed": false,
    "productionAuthorized": false,
    "providerCredentialGranted": false,
    "releaseAuthorized": false,
    "submissionAuthorized": false
  }
}
