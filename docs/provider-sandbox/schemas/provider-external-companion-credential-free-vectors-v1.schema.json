{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.foundation/schemas/provider-external-companion-credential-free-vectors-v1.schema.json",
  "title": "ProviderExternalCompanionCredentialFreeVectorsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "status", "protocolVersion", "positive", "negative", "authority"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "ProviderExternalCompanionCredentialFreeVectorsV1" },
    "status": { "const": "credential_free_vectors_non_authorizing" },
    "protocolVersion": { "const": "provider-technical-sandbox-v1" },
    "positive": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/positive" }
    },
    "negative": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/negative" }
    },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,95}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "opaqueIdentity": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9._:-]{8,2041}(?![\\s\\S])"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "provider", "accountId", "paperId", "dispatchAuthorizationHash", "packageHash", "liveActionAllowed"],
      "properties": {
        "environment": { "const": "provider_sandbox" },
        "provider": { "$ref": "#/$defs/text" },
        "accountId": { "$ref": "#/$defs/text" },
        "paperId": { "$ref": "#/$defs/text" },
        "dispatchAuthorizationHash": { "$ref": "#/$defs/opaqueIdentity" },
        "packageHash": { "$ref": "#/$defs/opaqueIdentity" },
        "liveActionAllowed": { "const": false }
      }
    },
    "expectedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "companionVersion",
        "providerReceiptSandbox",
        "credentialsObserved",
        "networkActionPerformed",
        "externalActionPerformed",
        "productionEligible",
        "externalAuthorityClaimed"
      ],
      "properties": {
        "kind": { "const": "ProviderTechnicalSandboxResponseV1" },
        "status": { "const": "technical_sandbox_response_incomplete_for_external_acceptance" },
        "companionVersion": { "const": "provider-technical-sandbox-v1" },
        "providerReceiptSandbox": { "const": true },
        "credentialsObserved": { "const": false },
        "networkActionPerformed": { "const": false },
        "externalActionPerformed": { "const": false },
        "productionEligible": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    },
    "positive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "expectedResponse"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "request": { "$ref": "#/$defs/request" },
        "expectedResponse": { "$ref": "#/$defs/expectedResponse" }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requestText", "expectedError", "expectedOutputCreated"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requestText": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "expectedError": {
          "type": "string",
          "pattern": "^provider_sandbox_[a-z0-9_:.-]{1,127}(?![\\s\\S])"
        },
        "expectedOutputCreated": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalAuthorityClaimed", "productionAuthorized", "providerCredentialGranted", "releaseAuthorized", "submissionAuthorized"],
      "properties": {
        "externalAuthorityClaimed": { "const": false },
        "productionAuthorized": { "const": false },
        "providerCredentialGranted": { "const": false },
        "releaseAuthorized": { "const": false },
        "submissionAuthorized": { "const": false }
      }
    }
  }
}
