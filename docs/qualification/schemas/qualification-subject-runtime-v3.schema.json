{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrillionniumFoundation/hepta-paper/docs/qualification/schemas/qualification-subject-runtime-v3.schema.json",
  "title": "QualificationSubjectV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "repository",
    "pullRequest",
    "definitionSetHash",
    "eligibleRunSetSha256",
    "producerHistoryWatermark",
    "selectedRunSetSha256",
    "artifactSetHash",
    "requiredCheckSnapshotIdentity",
    "producerHistories",
    "reviewBoundary",
    "authority",
    "snapshotIdentity"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "QualificationSubjectV3" },
    "status": { "const": "exact_subject_complete" },
    "repository": { "$ref": "#/$defs/repository" },
    "pullRequest": { "$ref": "#/$defs/pullRequest" },
    "definitionSetHash": { "$ref": "#/$defs/sha256" },
    "eligibleRunSetSha256": { "$ref": "#/$defs/sha256" },
    "producerHistoryWatermark": { "$ref": "#/$defs/timestamp" },
    "selectedRunSetSha256": { "$ref": "#/$defs/sha256" },
    "artifactSetHash": { "$ref": "#/$defs/sha256" },
    "requiredCheckSnapshotIdentity": { "$ref": "#/$defs/sha256" },
    "producerHistories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/producerHistory" }
    },
    "reviewBoundary": { "const": "separate_latest_head_merge_gate" },
    "authority": { "$ref": "#/$defs/authority" },
    "snapshotIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fullName"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "fullName": { "const": "TrillionniumFoundation/hepta-paper" }
      }
    },
    "gitObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "repository", "ref", "commit", "tree"],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "type": "string", "minLength": 3, "maxLength": 255 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" }
      }
    },
    "testedMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "parents"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/gitSha" }
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "state", "base", "head", "testedMerge"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "state": { "const": "open" },
        "base": { "$ref": "#/$defs/gitObject" },
        "head": { "$ref": "#/$defs/gitObject" },
        "testedMerge": { "$ref": "#/$defs/testedMerge" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "status", "conclusion"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["queued", "in_progress", "completed", "pending"] },
        "conclusion": {
          "type": ["string", "null"],
          "maxLength": 64
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "conclusion",
        "startedAt",
        "completedAt",
        "steps"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["queued", "in_progress", "completed", "pending"] },
        "conclusion": { "type": ["string", "null"], "maxLength": 64 },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sizeInBytes", "expired", "createdAt", "expiresAt", "digest"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sizeInBytes": { "type": "integer", "minimum": 0 },
        "expired": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "digest": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "eligibleRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "workflowPath",
        "runId",
        "runNumber",
        "runAttempt",
        "event",
        "headSha",
        "headBranch",
        "baseRef",
        "baseCommit",
        "status",
        "conclusion",
        "createdAt",
        "updatedAt",
        "checkSuiteId",
        "jobs",
        "jobSetSha256",
        "stepSetSha256",
        "artifacts",
        "artifactSetSha256"
      ],
      "properties": {
        "workflowId": { "type": "integer", "minimum": 1 },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$" },
        "runId": { "type": "integer", "minimum": 1 },
        "runNumber": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "event": { "const": "pull_request" },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "headBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "baseRef": { "type": "string", "minLength": 1, "maxLength": 255 },
        "baseCommit": { "$ref": "#/$defs/gitSha" },
        "status": { "enum": ["queued", "in_progress", "completed", "pending"] },
        "conclusion": { "type": ["string", "null"], "maxLength": 64 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "checkSuiteId": { "type": "integer", "minimum": 1 },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/job" }
        },
        "jobSetSha256": { "$ref": "#/$defs/sha256" },
        "stepSetSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "artifactSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producerHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "workflowPath",
        "requiredContexts",
        "canonicalRunId",
        "canonicalRunAttempt",
        "canonicalUpdatedAt",
        "eligibleRuns",
        "historyHash"
      ],
      "properties": {
        "workflowId": { "type": "integer", "minimum": 1 },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$" },
        "requiredContexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "canonicalRunId": { "type": "integer", "minimum": 1 },
        "canonicalRunAttempt": { "type": "integer", "minimum": 1 },
        "canonicalUpdatedAt": { "$ref": "#/$defs/timestamp" },
        "eligibleRuns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/eligibleRun" }
        },
        "historyHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized",
        "providerAuthorized",
        "campaignWriterActivated",
        "releaseAuthorized",
        "submissionAuthorized",
        "externalAuthorityClaimed"
      ],
      "properties": {
        "productionAuthorized": { "const": false },
        "providerAuthorized": { "const": false },
        "campaignWriterActivated": { "const": false },
        "releaseAuthorized": { "const": false },
        "submissionAuthorized": { "const": false },
        "externalAuthorityClaimed": { "const": false }
      }
    }
  }
}
