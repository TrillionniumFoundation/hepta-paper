{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.example/schemas/authenticated-codex-role-canary-v1.schema.json",
  "title": "Authenticated Codex Role Canary V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "repository",
    "commit",
    "tree",
    "runtimeIdentityHash",
    "providerAccountAuthorityDomain",
    "roles",
    "crossRoleAccessDenied",
    "campaignDatabaseAccessDenied",
    "externalAuthorityCredentialAccessDenied",
    "decision",
    "issuedAt",
    "signatureBase64"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "const": "EXT-CODEX-ROLE-001" },
    "repository": { "const": "TrillionniumFoundation/hepta-paper" },
    "commit": { "$ref": "#/$defs/gitHash" },
    "tree": { "$ref": "#/$defs/gitHash" },
    "runtimeIdentityHash": { "$ref": "#/$defs/sha256" },
    "providerAccountAuthorityDomain": { "$ref": "#/$defs/id" },
    "roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "uid",
          "gid",
          "homeIdentityHash",
          "socketIdentityHash",
          "journalIdentityHash",
          "schemaIdentityHash",
          "capabilityAudienceHash",
          "authenticated",
          "boundedCompletion",
          "environmentDisclosureDenied",
          "unexpectedFdDisclosureDenied",
          "receiptHash"
        ],
        "properties": {
          "role": { "enum": ["author", "reviewer", "formal_reviewer", "repairer"] },
          "uid": { "type": "integer", "minimum": 1 },
          "gid": { "type": "integer", "minimum": 1 },
          "homeIdentityHash": { "$ref": "#/$defs/sha256" },
          "socketIdentityHash": { "$ref": "#/$defs/sha256" },
          "journalIdentityHash": { "$ref": "#/$defs/sha256" },
          "schemaIdentityHash": { "$ref": "#/$defs/sha256" },
          "capabilityAudienceHash": { "$ref": "#/$defs/sha256" },
          "authenticated": { "const": true },
          "boundedCompletion": { "const": true },
          "environmentDisclosureDenied": { "const": true },
          "unexpectedFdDisclosureDenied": { "const": true },
          "receiptHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "crossRoleAccessDenied": { "const": true },
    "campaignDatabaseAccessDenied": { "const": true },
    "externalAuthorityCredentialAccessDenied": { "const": true },
    "promptOrManuscriptContentRetained": { "const": false },
    "decision": { "enum": ["approved", "rejected", "inconclusive"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signatureBase64": { "type": "string", "minLength": 40, "maxLength": 512 }
  },
  "$defs": {
    "gitHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
