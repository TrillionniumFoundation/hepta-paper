{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.foundation/schemas/hepta-paper/rust-effective-status-v1.schema.json",
  "title": "Hepta Rust exact-head effective source status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "repository",
    "source",
    "pullRequest",
    "workflow",
    "requiredContexts",
    "observedChecks",
    "effective",
    "validity",
    "invalidation",
    "authority"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "HeptaRustEffectiveSourceStatusV1"},
    "status": {"const": "exact_head_source_qualified"},
    "repository": {"const": "TrillionniumFoundation/hepta-paper"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "staticTruthSha256",
        "requiredChecksSha256",
        "producerManifestSha256",
        "capabilityEvidenceSha256",
        "checkEvidenceSha256",
        "effectiveSchemaSha256",
        "boundFiles"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "staticTruthSha256": {"$ref": "#/$defs/digest"},
        "requiredChecksSha256": {"$ref": "#/$defs/digest"},
        "producerManifestSha256": {"$ref": "#/$defs/digest"},
        "capabilityEvidenceSha256": {"$ref": "#/$defs/digest"},
        "checkEvidenceSha256": {"$ref": "#/$defs/digest"},
        "effectiveSchemaSha256": {"$ref": "#/$defs/digest"},
        "boundFiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "baseRef", "headBranch"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "baseRef": {"type": "string", "minLength": 1, "maxLength": 256},
        "headBranch": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runId", "runAttempt"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1}
      }
    },
    "requiredContexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "observedChecks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observedCheck"}
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentStatusRows",
        "workstreams",
        "backlogItemStatus",
        "parityItemStatus",
        "gaps",
        "supplementalBlockers"
      ],
      "properties": {
        "currentStatusRows": {"$ref": "#/$defs/statusMap"},
        "workstreams": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/workstream"}
        },
        "backlogItemStatus": {"$ref": "#/$defs/statusMap"},
        "parityItemStatus": {"$ref": "#/$defs/statusMap"},
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gap"}
        },
        "supplementalBlockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/gap"}
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "snapshotIdentity",
        "consumerMustRevalidateBeforeMergeOrActivation",
        "revalidatorPath"
      ],
      "properties": {
        "mode": {"const": "live_revalidation_required"},
        "snapshotIdentity": {"$ref": "#/$defs/digest"},
        "consumerMustRevalidateBeforeMergeOrActivation": {"const": true},
        "revalidatorPath": {"const": "docs/rust/tools/verify-effective-status-current.py"}
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headChangeInvalidates",
        "producerRunMutationInvalidates",
        "requiredCheckRerunInvalidatesOnNonSuccess",
        "missingOrSkippedJobInvalidates",
        "dirtyWorktreeInvalidates",
        "staticTruthDigestChangeInvalidates",
        "producerDefinitionChangeInvalidates",
        "capabilityEvidenceChangeInvalidates"
      ],
      "properties": {
        "headChangeInvalidates": {"const": true},
        "producerRunMutationInvalidates": {"const": true},
        "requiredCheckRerunInvalidatesOnNonSuccess": {"const": true},
        "missingOrSkippedJobInvalidates": {"const": true},
        "dirtyWorktreeInvalidates": {"const": true},
        "staticTruthDigestChangeInvalidates": {"const": true},
        "producerDefinitionChangeInvalidates": {"const": true},
        "capabilityEvidenceChangeInvalidates": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionAuthorized",
        "campaignWriterActivated",
        "liveProviderAuthorized",
        "releaseAuthorized",
        "submissionAuthorized",
        "externalAuthorityClaimed",
        "classification"
      ],
      "properties": {
        "productionAuthorized": {"const": false},
        "campaignWriterActivated": {"const": false},
        "liveProviderAuthorized": {"const": false},
        "releaseAuthorized": {"const": false},
        "submissionAuthorized": {"const": false},
        "externalAuthorityClaimed": {"const": false},
        "classification": {"const": "exact_head_repository_source_evidence_only"}
      }
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "enum": [
        "not_started",
        "design_ready",
        "source_implemented",
        "source_qualified",
        "hosted_installed_qualified",
        "target_host_qualified",
        "external_authority_qualified",
        "blocked_external",
        "retired"
      ]
    },
    "tier": {
      "enum": ["none", "design", "source", "hosted_installed", "target_host", "external_authority"]
    },
    "statusMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/status"}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "status", "conclusion"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"enum": ["completed", "in_progress", "queued", "pending"]},
        "conclusion": {"type": ["string", "null"], "enum": ["success", "skipped", "neutral", null]}
      }
    },
    "observedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "workflowId",
        "workflowPath",
        "workflowGitBlobSha",
        "workflowSha256",
        "event",
        "runId",
        "runAttempt",
        "runNumber",
        "checkSuiteId",
        "jobId",
        "jobName",
        "headSha",
        "headBranch",
        "baseRef",
        "pullRequestNumber",
        "status",
        "conclusion",
        "startedAt",
        "completedAt",
        "detailsUrl",
        "steps"
      ],
      "properties": {
        "context": {"type": "string", "minLength": 1, "maxLength": 256},
        "workflowId": {"type": "integer", "minimum": 1},
        "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"},
        "workflowGitBlobSha": {"$ref": "#/$defs/gitSha"},
        "workflowSha256": {"$ref": "#/$defs/digest"},
        "event": {"const": "pull_request"},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1},
        "runNumber": {"type": "integer", "minimum": 1},
        "checkSuiteId": {"type": "integer", "minimum": 1},
        "jobId": {"type": "integer", "minimum": 1},
        "jobName": {"type": "string", "minLength": 1, "maxLength": 256},
        "headSha": {"$ref": "#/$defs/gitSha"},
        "headBranch": {"type": "string", "minLength": 1, "maxLength": 256},
        "baseRef": {"type": "string", "minLength": 1, "maxLength": 256},
        "pullRequestNumber": {"type": "integer", "minimum": 1},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "startedAt": {"$ref": "#/$defs/nullableDateTime"},
        "completedAt": {"$ref": "#/$defs/nullableDateTime"},
        "detailsUrl": {"type": "string", "pattern": "^https://github\\.com/TrillionniumFoundation/hepta-paper/actions/runs/[0-9]+/job/[0-9]+$"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "evidenceTier"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 32},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"$ref": "#/$defs/status"},
        "evidenceTier": {"$ref": "#/$defs/tier"},
        "repositoryLocalStatus": {"$ref": "#/$defs/status"},
        "evidenceReference": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "evidenceTier", "external", "closesWhen"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"$ref": "#/$defs/status"},
        "evidenceTier": {"$ref": "#/$defs/tier"},
        "external": {"type": "boolean"},
        "issue": {"type": "integer", "minimum": 1},
        "repositoryLocalStatus": {"$ref": "#/$defs/status"},
        "evidenceReference": {"type": "string", "minLength": 1, "maxLength": 512},
        "closesWhen": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  }
}
