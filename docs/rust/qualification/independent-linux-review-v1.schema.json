{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.example/schemas/independent-linux-review-v1.schema.json",
  "title": "Independent Linux Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "repository",
    "commit",
    "tree",
    "reviewerAuthorityDomain",
    "reviewerKeyId",
    "reviewedObjects",
    "kernelAssumptions",
    "findings",
    "decision",
    "issuedAt",
    "signatureBase64"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "const": "EXT-HOST-CGROUP-001" },
    "repository": { "const": "TrillionniumFoundation/hepta-paper" },
    "commit": { "$ref": "#/$defs/gitHash" },
    "tree": { "$ref": "#/$defs/gitHash" },
    "reviewerAuthorityDomain": { "$ref": "#/$defs/id" },
    "reviewerKeyId": { "$ref": "#/$defs/id" },
    "reviewedObjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "kernelAssumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "unsafeOrFfiInventory": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "disposition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "disposition": { "enum": ["open", "fixed_and_reverified", "accepted_by_external_authority"] },
          "evidenceHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "decision": { "enum": ["approved", "rejected", "inconclusive"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signatureBase64": { "type": "string", "minLength": 40, "maxLength": 512 }
  },
  "$defs": {
    "gitHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
