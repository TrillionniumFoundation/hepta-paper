{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.example/schemas/production-cutover-soak-v1.schema.json",
  "title": "Production Cutover and Soak V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "repository",
    "commit",
    "tree",
    "databaseIdentityHash",
    "schemaVersionObserved",
    "oldWriterIdentity",
    "newWriterIdentity",
    "backupReceiptHash",
    "restoreReceiptHash",
    "logicalParityReceiptHash",
    "oldWorkersStopped",
    "oldLeasesCleared",
    "dualWriterObserved",
    "rollbackDrillPassed",
    "operationCount",
    "continuousSoakSeconds",
    "staleCommitCount",
    "duplicateIntegrationCount",
    "unexplainedSettlementCount",
    "unclassifiedRecoveryCount",
    "observerAuthorityDomain",
    "decision",
    "issuedAt",
    "signatureBase64"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "const": "EXT-CUTOVER-SOAK-001" },
    "repository": { "const": "TrillionniumFoundation/hepta-paper" },
    "commit": { "$ref": "#/$defs/gitHash" },
    "tree": { "$ref": "#/$defs/gitHash" },
    "databaseIdentityHash": { "$ref": "#/$defs/sha256" },
    "schemaVersionObserved": { "const": 25 },
    "oldWriterIdentity": { "$ref": "#/$defs/id" },
    "newWriterIdentity": { "$ref": "#/$defs/id" },
    "backupReceiptHash": { "$ref": "#/$defs/sha256" },
    "restoreReceiptHash": { "$ref": "#/$defs/sha256" },
    "logicalParityReceiptHash": { "$ref": "#/$defs/sha256" },
    "writerTransferReceiptHash": { "$ref": "#/$defs/sha256" },
    "oldWorkersStopped": { "const": true },
    "oldLeasesCleared": { "const": true },
    "dualWriterObserved": { "const": false },
    "rollbackDrillPassed": { "const": true },
    "terminalResumeDrillPassed": { "const": true },
    "operationCount": { "type": "integer", "minimum": 10000 },
    "continuousSoakSeconds": { "type": "integer", "minimum": 259200 },
    "staleCommitCount": { "const": 0 },
    "duplicateIntegrationCount": { "const": 0 },
    "unexplainedSettlementCount": { "const": 0 },
    "unclassifiedRecoveryCount": { "const": 0 },
    "observerAuthorityDomain": { "$ref": "#/$defs/id" },
    "observerKeyId": { "$ref": "#/$defs/id" },
    "decision": { "enum": ["approved", "rejected", "inconclusive"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signatureBase64": { "type": "string", "minLength": 40, "maxLength": 512 }
  },
  "$defs": {
    "gitHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
