{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.example/schemas/research-qualification-receipt-v4.schema.json",
  "title": "Restricted Research Qualification Receipt V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "status",
    "repository",
    "commit",
    "tree",
    "packages",
    "authorityGroups",
    "allPackagesVerified",
    "automaticActivation",
    "productionActivation",
    "sourceStatusUnchanged",
    "payloadSemantics",
    "clockRollbackProtection",
    "replayLedgerSchemaVersion",
    "trustStoreGeneration",
    "trustStoreHash",
    "researchWorkflowProfile",
    "replayProtection",
    "replayLedgerCommitted",
    "receiptHash"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "kind": {
      "const": "ResearchQualificationReceiptV4"
    },
    "status": {
      "const": "research_only_qualification_set_verified"
    },
    "repository": {
      "const": "TrillionniumFoundation/hepta-paper"
    },
    "commit": {
      "$ref": "#/$defs/gitHash"
    },
    "tree": {
      "$ref": "#/$defs/gitHash"
    },
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId",
          "payloadHash",
          "authorityDomainId",
          "signerKeyId",
          "nonce",
          "signingMessageHash"
        ],
        "properties": {
          "packageId": {
            "$ref": "#/$defs/packageId"
          },
          "payloadHash": {
            "$ref": "#/$defs/sha256"
          },
          "authorityDomainId": {
            "$ref": "#/$defs/id"
          },
          "signerKeyId": {
            "$ref": "#/$defs/id"
          },
          "nonce": {
            "$ref": "#/$defs/id"
          },
          "signingMessageHash": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "packageId"
            ],
            "properties": {
              "packageId": {
                "const": "EXT-HOST-CGROUP-001"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "packageId"
            ],
            "properties": {
              "packageId": {
                "const": "EXT-HOST-STORAGE-001"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "packageId"
            ],
            "properties": {
              "packageId": {
                "const": "EXT-KEY-OWNER-001"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "packageId"
            ],
            "properties": {
              "packageId": {
                "const": "EXT-CODEX-ROLE-001"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "authorityGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_host",
        "key_owner",
        "codex_account"
      ],
      "properties": {
        "target_host": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "key_owner": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "codex_account": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "allPackagesVerified": {
      "const": true
    },
    "automaticActivation": {
      "const": false
    },
    "productionActivation": {
      "const": false
    },
    "sourceStatusUnchanged": {
      "const": true
    },
    "receiptHash": {
      "$ref": "#/$defs/sha256"
    },
    "trustStoreGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "trustStoreHash": {
      "$ref": "#/$defs/sha256"
    },
    "researchWorkflowProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "stage",
        "repository",
        "commit",
        "tree",
        "qualificationBindingHash",
        "qualificationTrustStoreGeneration",
        "qualificationExpiresAtUnixMs",
        "qualifiedCodexRuntimeIdentityHash",
        "automaticActivation",
        "productionActivation",
        "releaseAuthority",
        "submissionAuthority"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "stage": {
          "const": "canary"
        },
        "repository": {
          "const": "TrillionniumFoundation/hepta-paper"
        },
        "commit": {
          "$ref": "#/$defs/gitHash"
        },
        "tree": {
          "$ref": "#/$defs/gitHash"
        },
        "qualificationBindingHash": {
          "$ref": "#/$defs/sha256"
        },
        "qualificationTrustStoreGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "qualificationExpiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "qualifiedCodexRuntimeIdentityHash": {
          "$ref": "#/$defs/sha256"
        },
        "automaticActivation": {
          "const": false
        },
        "productionActivation": {
          "const": false
        },
        "releaseAuthority": {
          "const": false
        },
        "submissionAuthority": {
          "const": false
        }
      },
      "description": "Directly reusable LocalWorkflowV1 researchProfile template. Diagnostic only; advancement requires the matching opaque V4 request authority."
    },
    "replayProtection": {
      "const": "durable_sqlite_v2"
    },
    "replayLedgerCommitted": {
      "const": true
    },
    "payloadSemantics": {
      "const": "strict_package_v1"
    },
    "clockRollbackProtection": {
      "const": true
    },
    "replayLedgerSchemaVersion": {
      "const": 2
    }
  },
  "$defs": {
    "gitHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "packageId": {
      "enum": [
        "EXT-HOST-CGROUP-001",
        "EXT-HOST-STORAGE-001",
        "EXT-KEY-OWNER-001",
        "EXT-CODEX-ROLE-001"
      ]
    }
  },
  "description": "Fixed four-package research-only recovery scope: signed host containment, storage recovery, key lifecycle and isolated Codex roles. Cutover, publication and governance packages are forbidden; all production/release/submission grants remain false. The storage package retains 10,000 operations and 72-hour soak qualification."
}
