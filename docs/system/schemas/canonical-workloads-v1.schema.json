{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hepta canonical workloads v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workloads"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "workloadId", "version", "purpose", "coreAssertions", "requiredEvidenceTier",
          "immutableByIdVersion", "zeroToleranceCounters", "ownerTeamIds", "relatedCapabilityIds",
          "relatedMilestoneIds", "metrics", "inputDeterminism", "minimumRepetitions", "maximumDurationSeconds"
        ],
        "properties": {
          "workloadId": { "type": "string", "pattern": "^PERF-WL-[0-9]{3}$" },
          "version": { "type": "integer", "minimum": 1 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
          "coreAssertions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "requiredEvidenceTier": { "enum": ["design", "source", "hosted_installed", "target_host", "external_authority"] },
          "immutableByIdVersion": { "const": true },
          "zeroToleranceCounters": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "ownerTeamIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TEAM-[A-Z]+$" } },
          "relatedCapabilityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" } },
          "relatedMilestoneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^G(?:[0-9]|10)$" } },
          "metrics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "inputDeterminism": { "enum": ["fixed_seed_and_hash_bound_inputs", "externally_observed_exact_subject"] },
          "minimumRepetitions": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "maximumDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 }
        }
      }
    }
  }
}
