{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planVersion",
    "historyPolicy",
    "roots",
    "singletons",
    "canonicalDocuments",
    "forbiddenPatterns",
    "localLinkRoots",
    "activeConsumerRoots",
    "activeConsumerFilePatterns",
    "forbiddenReferencePatterns",
    "referenceAllowlist"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planVersion": {
      "type": "string",
      "minLength": 1
    },
    "historyPolicy": {
      "const": "git_history_only"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "singletons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonicalDocuments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localLinkRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeConsumerRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeConsumerFilePatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenReferencePatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referenceAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumerPath",
          "reference",
          "reason"
        ],
        "properties": {
          "consumerPath": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
