{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.foundation/schemas/source-implementation-evidence-v1.schema.json",
  "title": "Repository source implementation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "repository",
    "subjectPolicy",
    "promotionPolicy",
    "registries",
    "bundles",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/source-implementation-evidence-v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "RepositorySourceImplementationEvidenceV1"
    },
    "repository": {
      "const": "TrillionniumFoundation/hepta-paper"
    },
    "subjectPolicy": {
      "const": "current_clean_git_head_tree_and_exact_blobs"
    },
    "promotionPolicy": {
      "const": "semantic_registry_binding_plus_exact_git_blobs_plus_executable_owner_tests"
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItems", "modules", "capabilities"],
      "properties": {
        "workItems": {
          "const": "docs/system/truth/work-items.v2.json"
        },
        "modules": {
          "const": "docs/system/truth/modules.v1.json"
        },
        "capabilities": {
          "const": "docs/system/truth/capabilities.v1.json"
        }
      }
    },
    "bundles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/bundle"
      }
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["constant", "function", "test", "type"]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "gitBlob", "mode", "language", "symbols"],
      "properties": {
        "path": {
          "$ref": "#/$defs/canonicalPath"
        },
        "role": {
          "enum": ["implementation", "test"]
        },
        "gitBlob": {
          "$ref": "#/$defs/sha1"
        },
        "mode": {
          "enum": ["100644", "100755"]
        },
        "language": {
          "enum": ["javascript", "json", "rust", "shell"]
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "args",
        "workdir",
        "expectedExitCode",
        "timeoutSeconds",
        "expectedTargets"
      ],
      "properties": {
        "program": {
          "enum": ["cargo", "node"]
        },
        "args": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        },
        "workdir": {
          "anyOf": [
            { "const": "." },
            { "$ref": "#/$defs/canonicalPath" }
          ]
        },
        "expectedExitCode": {
          "const": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "expectedTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonicalPath"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "files", "verificationCommands"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "authorityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetHostQualified",
        "externalAuthorityGranted",
        "productionActivated",
        "writerCutoverAuthorized",
        "nodeRetirementAuthorized"
      ],
      "properties": {
        "targetHostQualified": { "const": false },
        "externalAuthorityGranted": { "const": false },
        "productionActivated": { "const": false },
        "writerCutoverAuthorized": { "const": false },
        "nodeRetirementAuthorized": { "const": false }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "moduleId",
        "capabilityIds",
        "evidenceTier",
        "bundleIds",
        "promotionRequested",
        "authorityClaims"
      ],
      "properties": {
        "workItemId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "moduleId": {
          "type": "string",
          "pattern": "^module\\.[a-z0-9-]+$"
        },
        "capabilityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9-]+$"
          }
        },
        "evidenceTier": {
          "const": "source"
        },
        "bundleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "promotionRequested": {
          "type": "boolean"
        },
        "authorityClaims": {
          "$ref": "#/$defs/authorityClaims"
        }
      }
    }
  }
}
