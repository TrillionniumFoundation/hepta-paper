{
  "schemaVersion": 1,
  "planVersion": "1.1",
  "historyPolicy": "git_history_only",
  "roots": [
    "docs",
    "paper-core/docs"
  ],
  "singletons": [
    "README.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "rust/README.md"
  ],
  "canonicalDocuments": {
    "entry": "docs/README.md",
    "status": "docs/system/CURRENT_STATUS.md",
    "plan": "docs/system/MASTER_PLAN.md",
    "architecture": "docs/system/ARCHITECTURE.md",
    "backlog": "docs/system/BACKLOG.md",
    "risks": "docs/system/RISK_REGISTER.md",
    "invariants": "docs/system/INVARIANTS.md",
    "documentationGovernance": "docs/system/DOCUMENTATION_GOVERNANCE.md",
    "milestones": "docs/system/MILESTONE_GATES.md",
    "traceability": "docs/system/TRACEABILITY.md"
  },
  "forbiddenPatterns": [
    "(^|/)history(/|$)",
    "checkpoint",
    "trigger",
    "20[0-9]{6}.*\\.md$",
    "20[0-9]{2}-[0-9]{2}-[0-9]{2}.*\\.md$",
    "ALL_GAP_CLOSURE_WORKING_STATUS",
    "PLAN_V3_SOURCE_CLOSURE_ACCEPTANCE",
    "P0_EXECUTION_STATUS"
  ],
  "localLinkRoots": [
    "README.md",
    "RELEASE.md",
    "docs",
    "paper-core/docs",
    "rust/README.md"
  ],
  "activeConsumerRoots": [
    ".github/workflows",
    "package.json",
    "docs/tools",
    "docs/rust/qualification",
    "paper-core/bin",
    "paper-core/src",
    "rust/crates"
  ],
  "activeConsumerFilePatterns": [
    "(^|/)package\\.json$",
    "\\.ya?ml$",
    "\\.json$",
    "\\.mjs$",
    "\\.js$",
    "\\.sh$",
    "\\.py$",
    "\\.rs$",
    "\\.toml$"
  ],
  "forbiddenReferencePatterns": [
    "(^|/)paper-core/docs/history/",
    "(^|/)paper-core/docs/P0_EXECUTION_STATUS_2026-08-23\\.md$",
    "(^|/)docs/rust/(ALL_GAP_CLOSURE_WORKING_STATUS|PLAN_V3_SOURCE_CLOSURE_ACCEPTANCE|SOURCE_CLOSURE_CHECKPOINT_[^/]+|PR16_[^/]*TRIGGER_[^/]+)\\.md$",
    "(^|/)docs/rust/qualification/(PLAN_V3_EXTERNAL_GAP_EXECUTION|PLAN_V3_EXTERNAL_PACKAGE_INDEX|EXTERNAL_QUALIFICATION_CLOSURE|PR16_QUALIFICATION_CLI_TRIGGER_[^/]+)\\.md$"
  ],
  "referenceAllowlist": []
}
