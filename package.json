{
  "name": "hepta-paper-workspace",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "description": "Concurrent automation-first research, empirical, writing, referee and revision campaign system.",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "npm@10.9.8",
  "heptaPaper": {
    "activeRuntimeRoots": [
      "workflow-kernel",
      "paper-domain",
      "paper-application",
      "paper-ports",
      "paper-adapters",
      "paper-composition",
      "paper-core"
    ],
    "referencePackages": [
      {
        "name": "design-production-core",
        "path": "core",
        "classification": "pinned_submodule_reference",
        "baseline": "core/CORE_BASELINE.json",
        "productionImportPolicy": "forbidden"
      }
    ],
    "compatibilityManifest": "migration/compatibility-support.v1.json",
    "assetExternalizationManifest": "paper-core/config/repository-asset-externalization.v1.json"
  },
  "bin": {
    "paper-production-core": "./paper-core/bin/paper-production-core.mjs"
  },
  "scripts": {
    "hepta-paper": "node paper-core/bin/hepta-paper.mjs",
    "scripts:surface": "node paper-core/bin/command-surface.mjs",
    "scripts:check": "node paper-core/bin/command-surface.mjs --check-package",
    "scripts:sync": "node paper-core/bin/command-surface.mjs --write-package",
    "check:syntax": "node paper-core/bin/check-mjs-syntax.mjs",
    "lint": "eslint --max-warnings=0 .",
    "release:state-check": "node paper-core/bin/release-state-check.mjs",
    "static:check": "npm run scripts:check && npm run check:syntax && npm run lint && npm run release:state-check && node --test --test-concurrency=1 paper-core/tests/release-state-consistency.test.mjs paper-core/tests/architecture-conformance.test.mjs paper-core/tests/repository-module-imports.test.mjs",
    "test": "npm run static:check && node paper-core/bin/run-isolated-verification.mjs test",
    "test:impacted": "node paper-core/bin/run-impacted-tests.mjs",
    "test:impacted:plan": "node paper-core/bin/run-impacted-tests.mjs --dry-run --json",
    "reference:baseline:accept": "node paper-core/bin/core-integrity.mjs --write-baseline",
    "reference:integrity": "node paper-core/bin/core-integrity.mjs",
    "reference:selftest": "npm --prefix core run selftest",
    "reference:selftest:workspace": "npm --prefix core run selftest:workspace",
    "reference:runtime-dry-run": "npm --prefix core run runtime:dry-run-harness",
    "paper:selftest": "node paper-core/bin/run-isolated-command.mjs node paper-core/verification/selftest.mjs",
    "paper:remediation-selftest": "node paper-core/bin/run-isolated-command.mjs node paper-core/verification/remediation-selftest.mjs",
    "paper:authority-selftest": "node paper-core/bin/run-isolated-command.mjs node paper-core/verification/authority-pipeline-selftest.mjs",
    "paper:architecture-selftest": "node paper-core/bin/run-isolated-command.mjs node --test paper-core/tests/architecture-conformance.test.mjs",
    "paper:capability-tests": "node paper-core/bin/run-isolated-command.mjs node --test migration/tests/capabilities/*.test.mjs",
    "paper:capability-conformance": "node paper-core/bin/run-isolated-command.mjs node migration/bin/verify-capabilities.mjs",
    "paper:governance-contracts": "node paper-core/bin/run-isolated-command.mjs node --test migration/tests/owner-acceptance-families.test.mjs migration/tests/operational-proof-intake.test.mjs paper-core/tests/external-intake-verifier.test.mjs paper-core/tests/cold-volume-contract.test.mjs paper-core/tests/repair-command-contract.test.mjs",
    "safety:p0": "npm run safety:p0:inner && npm run coverage:critical-modules",
    "safety:p0:inner": "node paper-core/bin/run-isolated-command.mjs node --test --test-concurrency=1 migration/tests/capabilities/runtime.job-receipt-store.test.mjs paper-core/tests/native-receipt-hash-policy.test.mjs paper-core/tests/campaign-attempt-fencing.test.mjs paper-core/tests/workspace-attempt-integration.test.mjs paper-core/tests/runtime-retention.test.mjs paper-core/tests/workflow-state-store.test.mjs paper-core/tests/paper-batch-dry-run.test.mjs paper-core/tests/workspace-snapshot-exporter.test.mjs paper-core/tests/automation-executors.test.mjs paper-core/tests/campaign-empirical-repair-semantics.test.mjs paper-core/tests/academic-docker-operational-prerequisites.test.mjs paper-core/tests/hepta-store-restore-drill-exit.test.mjs paper-core/tests/isolated-verification-policy.test.mjs paper-core/tests/verification-runtime-isolation.test.mjs",
    "safety:p1": "node paper-core/bin/run-isolated-command.mjs npm run safety:p1:inner",
    "safety:p1:inner": "node --test --test-concurrency=1 paper-core/tests/campaign-release-handoff.test.mjs paper-core/tests/composition-context-profiles.test.mjs paper-core/tests/typed-persistence-ports.test.mjs",
    "safety:p2": "node paper-core/bin/run-isolated-command.mjs npm run safety:p2:inner",
    "safety:p2:inner": "node --test --test-concurrency=1 paper-core/tests/architecture-conformance.test.mjs paper-core/tests/production-complexity.test.mjs paper-core/tests/repository-module-imports.test.mjs paper-core/tests/domain-purity-identity.test.mjs paper-core/tests/workflow-operational-authority.test.mjs paper-core/tests/campaign-state-policy.test.mjs paper-core/tests/package-script-surface.test.mjs paper-core/tests/runtime-permissions.test.mjs",
    "safety:all": "npm run safety:p0 && npm run safety:p1 && npm run safety:p2",
    "paper:batch": "node paper-core/bin/paper-production-core.mjs batch-run",
    "paper:campaign": "node paper-core/bin/paper-campaign.mjs",
    "paper:campaign-worker": "node paper-core/bin/paper-campaign-dispatcher.mjs",
    "paper:submission-handoff": "node paper-core/bin/paper-submission-handoff.mjs",
    "automation:status": "node paper-core/bin/automation-status.mjs",
    "automation:external-authority-intake": "node paper-core/bin/production-external-authority-intake.mjs",
    "automation:capability-matrix": "node paper-core/bin/research-capability-matrix.mjs",
    "automation:journal-connector-coverage": "node paper-core/bin/journal-connector-coverage.mjs",
    "automation:generic-domain-capability-evidence": "node paper-core/bin/generic-domain-capability-evidence.mjs",
    "automation:research-status": "node paper-core/bin/automation-status.mjs --require-full-research --live-provider-canary --live-release-attestor",
    "automation:autonomous-research-readiness": "node paper-core/bin/autonomous-research-readiness.mjs",
    "automation:strict-full-auto-acceptance": "node paper-core/bin/strict-full-auto-acceptance.mjs",
    "automation:autonomous-empirical-plugin-release": "node paper-core/bin/autonomous-empirical-plugin-release.mjs",
    "automation:advanced-numerical-plugin": "node paper-core/bin/advanced-numerical-plugin.mjs",
    "automation:autonomous-submission-dispatcher": "node paper-core/bin/autonomous-submission-dispatcher.mjs",
    "automation:autonomous-submission-dispatcher-challenge": "node paper-core/bin/autonomous-submission-dispatcher-challenge.mjs",
    "automation:autonomous-research-supervisor": "node paper-core/bin/autonomous-research-supervisor.mjs",
    "automation:autonomous-research-supervisor-health": "node paper-core/bin/autonomous-research-supervisor-health.mjs",
    "automation:nested-runtime-platform-qualification": "node paper-core/bin/nested-runtime-platform-qualification.mjs",
    "automation:autonomous-research-state-backup": "node paper-core/bin/autonomous-research-state-backup.mjs",
    "automation:autonomous-research-one-shot-campaign-attempt": "node paper-core/bin/autonomous-research-one-shot-campaign-attempt.mjs",
    "automation:autonomous-research-state-provision": "node paper-core/bin/autonomous-research-state-provision.mjs",
    "automation:autonomous-research-state-partial-root-maintenance": "node paper-core/bin/autonomous-research-state-partial-root-maintenance.mjs",
    "automation:autonomous-research-online-schema-transition": "node paper-core/bin/autonomous-research-online-schema-transition.mjs",
    "automation:autonomous-research-intake-authority-rotation": "node paper-core/bin/autonomous-research-machine-intake-authority-rotation.mjs",
    "automation:reconcile": "node paper-core/bin/automation-reconcile.mjs",
    "automation:reconcile:execute": "node paper-core/bin/automation-reconcile.mjs --execute",
    "automation:workspace-backfill": "node paper-core/bin/workspace-lineage-backfill.mjs",
    "automation:workspace-backfill:execute": "node paper-core/bin/workspace-lineage-backfill.mjs --execute",
    "automation:dashboard": "node paper-core/bin/automation-dashboard.mjs --json",
    "automation:agent-smoke": "node paper-core/bin/automation-agent-smoke.mjs",
    "automation:campaign-smoke": "node paper-core/bin/automation-campaign-smoke.mjs",
    "automation:runtime-smoke": "node paper-core/bin/automation-runtime-smoke.mjs",
    "automation:openclaw-multipaper-smoke": "node paper-core/bin/automation-openclaw-multipaper-smoke.mjs",
    "automation:strict-rereview-smoke": "node paper-core/bin/automation-strict-rereview-smoke.mjs",
    "automation:runtime-build": "npm run automation:runtime-bootstrap:python -- --profile python --build && npm run automation:runtime-bootstrap:python -- --profile pythonGpu --build && npm run automation:runtime-bootstrap:r -- --build",
    "automation:runtime-bootstrap:python": "node paper-core/bin/automation-python-runtime-bootstrap.mjs",
    "automation:runtime-bootstrap:r": "node paper-core/bin/automation-r-runtime-bootstrap.mjs",
    "automation:runtime-image-bundle-load": "node paper-core/bin/automation-runtime-image-bundle-loader.mjs",
    "automation:runtime-reproducibility": "node paper-core/bin/runtime-image-reproducibility.mjs",
    "automation:runtime-r-source-cas": "node paper-core/bin/runtime-r-source-cas.mjs",
    "migration:retirement-status": "npm run legacy:reference-verify && npm run migration:matrix-integrity",
    "migration:p0-selftest": "node paper-core/bin/run-isolated-command.mjs npm run migration:p0-inner",
    "migration:p0-inner": "node migration/tests/p0-entrypoint-and-batch-parity.mjs && node migration/tests/p0-paperctl-command-disposition.mjs && node migration/tests/p0-production-core-differential.mjs",
    "migration:p1-plugin-selftest": "node paper-core/bin/run-isolated-command.mjs node migration/tests/p1-plugin-wrapper-boundaries.mjs",
    "migration:p1-venue-selftest": "node paper-core/bin/run-isolated-command.mjs node migration/tests/p1-venue-resolve-retirements.mjs",
    "migration:p1-referee-selftest": "node paper-core/bin/run-isolated-command.mjs npm run migration:p1-referee-inner",
    "migration:p1-referee-inner": "node migration/tests/p1-referee-revise-retirements.mjs && node migration/tests/p1-referee-revision-differential.mjs",
    "migration:p1-build-package-selftest": "node paper-core/bin/run-isolated-command.mjs node migration/tests/p1-build-package-retirements.mjs",
    "migration:p1-submission-selftest": "node paper-core/bin/run-isolated-command.mjs node migration/tests/p1-submission-boundaries.mjs",
    "migration:p1-research-selftest": "node paper-core/bin/run-isolated-command.mjs node migration/tests/p1-research-verify-retirements.mjs",
    "migration:matrix-integrity": "node paper-core/bin/run-isolated-command.mjs node migration/tests/matrix-integrity.mjs",
    "migration:matrix-refresh-hashes": "node migration/bin/refresh-semantic-migration-hashes.mjs --execute",
    "migration:capability-matrix-v3": "node paper-core/bin/run-isolated-command.mjs sh -lc 'node migration/bin/verify-capabilities.mjs && node migration/tests/capability-matrix-v3.mjs --release-profile'",
    "migration:salvage-manifest": "node --test migration/tests/legacy-salvage-manifest.test.mjs",
    "migration:salvage-selftest": "node paper-core/bin/run-isolated-command.mjs sh -lc 'node --test migration/tests/legacy-salvage-manifest.test.mjs && node migration/bin/verify-legacy-salvage-replacements.mjs'",
    "migration:salvage-verification-receipt": "node migration/bin/verify-legacy-salvage-replacements.mjs --write",
    "paper:salvage-hardening-selftest": "node paper-core/bin/run-declared-test-suite.mjs salvage-hardening full",
    "paper:salvage-hardening-selftest:deduplicated": "node paper-core/bin/run-declared-test-suite.mjs salvage-hardening deduplicated",
    "test:migration-differential": "node migration/tests/p0-production-core-differential.mjs && node migration/tests/p1-referee-revision-differential.mjs",
    "coverage:architecture": "node paper-core/bin/run-isolated-command.mjs npm run coverage:architecture-inner",
    "coverage:architecture-inner": "node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-lines=65 --test-coverage-include=paper-application/execution-context.mjs --test-coverage-include=paper-domain/workflow/mode-registry.mjs --test-coverage-include=paper-adapters/artifacts/filesystem-artifact-repository.mjs --test-coverage-include=paper-adapters/persistence/sqlite-store.mjs --test-coverage-include=paper-domain/research/*.mjs --test-coverage-include=paper-domain/submission/*.mjs paper-core/tests/architecture-conformance.test.mjs paper-core/tests/autonomous-research-generalization-agenda-formal.test.mjs paper-core/tests/autonomous-research-generalization-contracts.test.mjs paper-core/tests/dynamic-formal-claim-kernel-e2e.test.mjs paper-core/tests/empirical-claim-authority.test.mjs paper-core/tests/empirical-assertion-contract.test.mjs paper-core/tests/evidence-entailment-closed-loop.test.mjs paper-core/tests/formal-claim-binding-policy.test.mjs paper-core/tests/formal-proof-search-operations.test.mjs paper-core/tests/formal-readable-proof-contract.test.mjs paper-core/tests/http-prior-art-retrieval-adapter-v2.test.mjs paper-core/tests/reviewer-cryptographic-trust-v2.test.mjs paper-core/tests/submission-live-delivery.test.mjs paper-core/tests/sqlite-store-failure-contract.test.mjs paper-core/tests/typed-numeric-oracle-production.test.mjs paper-core/tests/typed-persistence-ports.test.mjs paper-core/tests/typed-theorem-dependency-graph.test.mjs paper-core/tests/typed-theorem-proof-search.test.mjs migration/tests/capabilities/research.claim-registry.test.mjs",
    "coverage:critical-modules": "node paper-core/bin/run-isolated-command.mjs node paper-core/bin/critical-module-coverage.mjs",
    "coverage:repository": "node paper-core/bin/run-isolated-command.mjs npm run coverage:repository-inner",
    "coverage:repository-inner": "node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-lines=30 --test-coverage-branches=54 --test-coverage-functions=50 --test-coverage-include='paper-domain/**/*.mjs' --test-coverage-include='paper-ports/**/*.mjs' --test-coverage-include='workflow-kernel/**/*.mjs' --test-coverage-include='paper-adapters/**/*.mjs' --test-coverage-include='paper-application/**/*.mjs' --test-coverage-include='paper-core/src/**/*.mjs' paper-core/tests/*.test.mjs migration/tests/capabilities/*.test.mjs migration/tests/*.test.mjs",
    "coverage:system": "node paper-core/bin/run-isolated-command.mjs npm run coverage:system-inner",
    "coverage:system-inner": "HEPTA_ACADEMIC_DOCKER_OPERATIONAL_MODE=coverage node --experimental-test-coverage --test --test-concurrency=1 --test-skip-pattern='^academic-docker-operational:' --test-coverage-lines=80 --test-coverage-branches=54 --test-coverage-functions=80 --test-coverage-include='paper-domain/**/*.mjs' --test-coverage-include='paper-ports/**/*.mjs' --test-coverage-include='workflow-kernel/**/*.mjs' --test-coverage-include='paper-adapters/**/*.mjs' --test-coverage-include='paper-application/**/*.mjs' --test-coverage-include='paper-core/src/**/*.mjs' paper-core/tests/*.test.mjs migration/tests/capabilities/*.test.mjs migration/tests/*.test.mjs paper-core/verification/selftest.mjs",
    "test:academic-docker-operational": "node paper-core/bin/academic-docker-operational.mjs",
    "test:typed-numeric-process-operational": "node --test --test-concurrency=1 paper-core/tests/typed-numeric-oracle-production.test.mjs",
    "test:dynamic-formal-kernel-operational": "node paper-core/bin/dynamic-formal-kernel-operational.mjs",
    "ci:selftest": "npm run static:check && node paper-core/bin/run-isolated-verification.mjs ci",
    "ci:mathlib-cache": "node paper-core/bin/prepare-ci-mathlib-cache.mjs --prepare",
    "ci:inner": "npm run reference:integrity && npm run reference:selftest && npm run reference:runtime-dry-run && npm run safety:all && npm run paper:capability-conformance && npm run paper:governance-contracts && npm run migration:capability-matrix-v3 && npm run migration:salvage-selftest && npm run paper:salvage-hardening-selftest && npm run assets:cold-volume-status && npm run assets:cold-volume-cas-status && npm run legacy:fixture-verify && npm run legacy:matrix-reference-status",
    "release:verify": "npm run static:check && npm run release:state-check -- --require-state release_ready && node paper-core/bin/run-isolated-verification.mjs release",
    "release:inner": "npm run test:inner && npm run provider:sandbox-selftest && npm run coverage:architecture && npm run coverage:system && npm run test:academic-docker-operational && npm run test:migration-differential && npm run assets:cold-volume-release-gate && npm run assets:cold-volume-cas-release-gate && npm run legacy:fixture-verify && npm run legacy:matrix-reference-status && npm run legacy:deletion-drill && npm run workspace:verify-decoupled && npm run store:trust-status && npm run release:trust-gate && npm run store:logical-integrity && npm run store:restore-drill",
    "audit:local-accepts": "node paper-core/bin/run-isolated-command.mjs node paper-core/bin/reassess-local-accepts.mjs",
