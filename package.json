    "store:migrate": "node paper-core/bin/hepta-store.mjs migrate",
    "store:backup": "node paper-core/bin/hepta-store.mjs backup",
    "store:restore-drill": "node paper-core/bin/hepta-store.mjs restore-drill",
    "store:status": "node paper-core/bin/hepta-store.mjs status",
    "store:trust-status": "node paper-core/bin/hepta-store.mjs status --require-trust-clean --allow-isolated-verification-evidence",
    "store:logical-integrity": "node paper-core/bin/hepta-store-logical-integrity.mjs",
    "store:repair-ledger-integrity": "node paper-core/bin/repair-receipt-ledger-integrity.mjs",
    "workspace:status": "node paper-core/bin/workspace-status.mjs",
    "workspace:verify-decoupled": "node paper-core/bin/workspace-status.mjs --require-decoupled",
    "authority:status": "node paper-core/bin/authority-status.mjs --json",
    "owner:status": "node paper-core/bin/owner-acceptance-status.mjs",
    "owner:refresh-local-admin": "node migration/bin/refresh-local-admin-owner-acceptance.mjs --execute",
    "operational:status": "node paper-core/bin/operational-proof-status.mjs",
    "release:trust-gate": "node paper-core/bin/release-trust-gate.mjs",
    "conformance:replay": "node migration/bin/run-production-capability-replays.mjs --execute",
    "assets:cold-volume-status": "node paper-core/bin/verify-cold-volume-contract.mjs",
    "assets:cold-volume-release-gate": "node paper-core/bin/verify-cold-volume-contract.mjs --require-mounted",
    "assets:cold-volume-cas-status": "node paper-core/bin/cold-volume-cas.mjs status",
    "assets:cold-volume-cas-release-gate": "node paper-core/bin/cold-volume-cas.mjs status --require-ready",
    "assets:cold-volume-cas-import": "node paper-core/bin/cold-volume-cas.mjs import",
    "assets:cold-volume-cas-restore-drill": "node paper-core/bin/cold-volume-cas.mjs restore-drill",
    "assets:repository-status": "node paper-core/bin/repository-asset-status.mjs",
    "reports:quarantine-stale": "node paper-core/bin/quarantine-stale-latest.mjs",
    "release:attest": "node paper-core/bin/release-evidence.mjs --execute",
    "release:key": "node paper-core/bin/release-integrity-key.mjs",
    "legacy:reference-verify": "node migration/bin/verify-retirement-source-snapshot.mjs",
    "legacy:fixture-verify": "node paper-core/bin/verify-legacy-reference-fixture.mjs",
    "legacy:matrix-reference-status": "node paper-core/bin/legacy-matrix-reference-status.mjs",
    "legacy:deletion-drill": "node paper-core/bin/legacy-deletion-drill.mjs",
    "offhost:worm-status": "node paper-core/bin/offhost-worm-snapshot.mjs status",
    "offhost:worm-snapshot": "node paper-core/bin/offhost-worm-snapshot.mjs snapshot",
    "offhost:worm-restore-drill": "node paper-core/bin/offhost-worm-snapshot.mjs restore-drill",
    "runtime:hygiene": "node paper-core/bin/runtime-hygiene.mjs --execute",
    "runtime:permissions": "node paper-core/bin/runtime-permissions.mjs",
    "external:intake": "node paper-core/bin/generate-external-intake.mjs",
    "external:intake-verify": "node paper-core/bin/verify-external-intake.mjs",
    "compat:legacy-workflow-projection": "node paper-core/bin/paper-compat-workflow-projection.mjs",
    "experimental:real-paper-pilot": "node paper-core/experimental/run-real-paper-pilot.mjs",
    "experimental:taskflow-selftest": "node --test paper-core/tests/taskflow-reviewed-submit.test.mjs paper-core/tests/workflow-state-store.test.mjs",
    "automation:selftest": "node paper-core/bin/run-declared-test-suite.mjs automation full",
    "automation:selftest:deduplicated": "node paper-core/bin/run-declared-test-suite.mjs automation deduplicated",
    "provider:sandbox-selftest": "node --test paper-core/tests/provider-sandbox-integration.test.mjs",
    "paper:real-provider-sandbox": "node paper-core/bin/run-real-paper-provider-sandbox.mjs",
    "test:inner": "npm run reference:integrity && npm run reference:selftest && npm run reference:runtime-dry-run && npm run safety:all && npm run automation:selftest:deduplicated && npm run paper:salvage-hardening-selftest:deduplicated && npm run paper:selftest && npm run paper:remediation-selftest && npm run paper:authority-selftest && npm run paper:capability-conformance && npm run paper:governance-contracts && npm run migration:matrix-integrity && npm run migration:capability-matrix-v3 && npm run migration:salvage-selftest"
