{
  "version": 1,
  "kind": "PersonalSelfHostedProductionProfile",
  "profileId": "personal-self-hosted-v1",
  "scope": {
    "operatorCardinality": "single-user",
    "distributionMode": "private-local-only",
    "commercialDistribution": false,
    "externalActions": false
  },
  "externalBlockerDisposition": {
    "GAP-HOST-001": {
      "disposition": "scoped_out",
      "reason": "broker-listener-not-enabled-in-personal-profile"
    },
    "GAP-HOST-002": {
      "disposition": "scoped_out",
      "reason": "destructive-host-soak-not-enabled-in-personal-profile"
    },
    "GAP-KEY-001": {
      "disposition": "not_applicable",
      "reason": "no-external-actions-or-distributed-signing"
    },
    "GAP-CODEX-001": {
      "disposition": "not_applicable",
      "reason": "no-live-provider-or-external-broker-actions"
    },
    "GAP-REL-001": {
      "disposition": "not_applicable",
      "reason": "no-release-portal-submission-or-distribution"
    },
    "LEGACY-REPLAY-001": {
      "disposition": "scoped_out",
      "reason": "unsupported-routes-not-enabled-in-personal-profile"
    }
  },
  "localOperationMapping": {
    "targetHost": {
      "disposition": "replaced_by_local_deterministic_controls",
      "controlIds": [
        "credential-and-runtime-boundary",
        "database-inventory-and-schema"
      ],
      "reason": "private-profile-has-no-broker-listener-or-destructive-host-soak"
    },
    "installation": {
      "disposition": "local_source_bound",
      "controlIds": [
        "credential-and-runtime-boundary",
        "exact-code-provenance"
      ],
      "reason": "workspace-and-runtime-ownership-are-the-private-install-boundary"
    },
    "canary": {
      "disposition": "local_deterministic_replay",
      "controlIds": [
        "enabled-scientific-oracles",
        "formal-operational-zero-skipped"
      ],
      "reason": "formal-and-enabled-capability-replay-cover-local-behavior"
    },
    "rollback": {
      "disposition": "local_restore_and_anti_rollback",
      "controlIds": [
        "database-restore-drill",
        "online-anti-rollback"
      ],
      "reason": "local-restore-and-monotonic-ledger-cover-local-recovery"
    }
  },
  "notApplicableControls": [
    {
      "controlId": "hardware-kms-hsm",
      "reason": "no-distributed-release-signing-key-is-used"
    },
    {
      "controlId": "independent-external-authority-roles",
      "reason": "no-external-authority-or-multi-operator-release-claim"
    },
    {
      "controlId": "kubernetes-release-digest",
      "reason": "no-kubernetes-deployment"
    },
    {
      "controlId": "local-author-review-session-separation",
      "reason": "single-operator-no-review-workflow"
    },
    {
      "controlId": "oci-registry-attestation",
      "reason": "no-oci-registry-distribution"
    },
    {
      "controlId": "offhost-worm-custody",
      "reason": "private-single-host-scope-with-local-backup-contract"
    },
    {
      "controlId": "venue-portal-live-submission",
      "reason": "no-external-submission-or-publishing-action"
    }
  ],
  "requiredLocalControls": [
    {
      "controlId": "credential-and-runtime-boundary",
      "evidenceKind": "LocalCredentialRuntimeBoundaryEvidence",
      "description": "Secrets are absent from artifacts and runtime files are owner-controlled."
    },
    {
      "controlId": "database-inventory-and-schema",
      "evidenceKind": "LocalDatabaseInventoryEvidence",
      "description": "All declared local databases exist, pass immutable inspection, and match schema contracts."
    },
    {
      "controlId": "database-restore-drill",
      "evidenceKind": "LocalDatabaseRestoreEvidence",
      "description": "A local restore drill was executed and its receipt is current."
    },
    {
      "controlId": "enabled-scientific-oracles",
      "evidenceKind": "LocalScientificOracleEvidence",
      "description": "Every enabled CPU/GPU scientific capability has deterministic replay and an error budget."
    },
    {
      "controlId": "exact-code-provenance",
      "evidenceKind": "LocalExactCodeProvenanceEvidence",
      "description": "Clean worktree and exact commit/tree/content binding."
    },
    {
      "controlId": "formal-operational-zero-skipped",
      "evidenceKind": "LocalFormalOperationalEvidence",
      "description": "Formal operational test receipt has no skipped, failed, or todo tests."
    },
    {
      "controlId": "online-anti-rollback",
      "evidenceKind": "LocalOnlineAntiRollbackEvidence",
      "description": "Online mutation markers and the local integrity pin prevent rollback/equivocation."
    }
  ],
  "optionalDiagnostics": [
    {
      "diagnosticId": "local-slo-alert-policy",
      "blocking": false,
      "description": "Automatically observed local health signals; absence never blocks personal readiness."
    }
  ],
  "scientificCapabilities": {
    "cpu": {
      "defaultEnabled": true,
      "requiredEvidence": [
        "deterministic-replay",
        "error-budget",
        "model-data-checkpoint-ir"
      ]
    },
    "gpu": {
      "defaultEnabled": false,
      "optInEnvironment": "HEPTA_PERSONAL_GPU_ENABLED",
      "requiredEvidence": [
        "same-device-replay",
        "deterministic-replay",
        "error-budget",
        "model-data-checkpoint-ir"
      ]
    }
  },
  "prohibitedActions": [
    "external-submission",
    "publication-claim",
    "multi-operator-release",
    "distribution-from-personal-profile"
  ],
  "profileHash": "sha256:2be3c2639037a21953e3340d2d24e5b486420e1c91fae04856ad8f28521c8098"
}
