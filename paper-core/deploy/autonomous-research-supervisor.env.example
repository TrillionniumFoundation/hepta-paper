# Non-secret deployment policy. Install as
# /etc/hepta-paper/autonomous-research-supervisor.env mode 0600.
HEPTA_PAPER_ASSET_ROOT=/srv/hepta-paper/assets
# This is the only host root permitted in topic-producer datasetMounts[].source
# entries. The profile stores exact absolute paths and startup resolves them.
HEPTA_AUTONOMOUS_RESEARCH_DATASET_ROOT=/srv/hepta-paper/datasets
HEPTA_PAPER_RUNTIME_ROOT=/var/lib/hepta-paper/runtime
HEPTA_AUTONOMOUS_RESEARCH_INTAKE_CONFIG=/etc/hepta-paper/intake/config.json
HEPTA_AUTONOMOUS_RESEARCH_TOPIC_PRODUCER_PROFILE=/etc/hepta-paper/intake/topic-producer-profile.json
HEPTA_SUPERVISOR_POLL_MS=5000
HEPTA_SUPERVISOR_INSTANCE_LEASE_MS=900000
HEPTA_SUPERVISOR_INSTANCE_HEARTBEAT_MS=30000
HEPTA_SUPERVISOR_MAXIMUM_DISPATCHES=256
HEPTA_SUPERVISOR_MAXIMUM_LIFECYCLE_COST_USD=150
HEPTA_SUPERVISOR_MAXIMUM_LIFETIME_MS=604800000
HEPTA_SUPERVISOR_QUALIFICATION_ACTION_SAFETY_MARGIN_MS=900000
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_CONFIG=/etc/hepta-paper/runtime-reproducibility/process-config.json
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_MAXIMUM_REFRESH_ATTEMPTS_PER_EPOCH=4
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_MAXIMUM_REFRESH_COST_USD_PER_EPOCH=REPLACE_WITH_FIXED_EPOCH_BUDGET_USD
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_REFRESH_RENEWAL_LEAD_MS=REPLACE_WITH_CONFIG_MINIMUM_LEAD_PLUS_BACKOFF_MS
# Qualification and runtime receipts must cover the remaining campaign wall
# budget plus these non-resettable safety margins before any resume dispatch.
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_REFRESH_ACTION_SAFETY_MARGIN_MS=900000

# These are paths, never inline credentials. The directories must be distinct,
# owned by the service account, and mode 0700. Their config files must be 0600.
HEPTA_RESEARCH_AUTHOR_CODEX_HOME=/etc/hepta-paper/credentials/research-author
HEPTA_FORMAL_REVIEW_CODEX_HOME=/etc/hepta-paper/credentials/formal-reviewer
HEPTA_RESEARCH_AUTHOR_MODEL=REPLACE_WITH_PINNED_MODEL
HEPTA_FORMAL_REVIEW_MODEL=REPLACE_WITH_PINNED_MODEL
HEPTA_RESEARCH_AUTHOR_MAXIMUM_COST_PER_CALL_USD=REPLACE_WITH_PROVIDER_CONTRACT_MAXIMUM
HEPTA_FORMAL_REVIEWER_MAXIMUM_COST_PER_CALL_USD=REPLACE_WITH_PROVIDER_CONTRACT_MAXIMUM
HEPTA_AUTONOMOUS_EXTERNAL_QUALIFICATION_CONFIG=/etc/hepta-paper/qualification/process-config.json
HEPTA_RESEARCH_EXECUTION_RELEASE_ATTESTOR_CONFIG=/etc/hepta-paper/release-attestor/config.json
# Public-trust and pinned-client configurations for the transaction-time
# reserve/apply/finalize authority and whole-state backup authority. These
# files may reference dedicated broker client executables, but must never
# contain broker private keys or inline credentials.
HEPTA_AUTONOMOUS_RESEARCH_ONLINE_MUTATION_AUTHORITY_PROCESS_CONFIG=/etc/hepta-paper/online-mutation-authority/process-config.json
HEPTA_AUTONOMOUS_RESEARCH_ONLINE_MUTATION_AUTHORITY_CONFIG=/etc/hepta-paper/online-mutation-authority/authority-config.json
HEPTA_AUTONOMOUS_SUBMISSION_HANDOFF_MUTATION_AUTHORITY_PROCESS_CONFIG=/etc/hepta-paper/submission-handoff-authority/process-config.json
HEPTA_AUTONOMOUS_RESEARCH_STATE_BACKUP_AUTHORITY_CONFIG=/etc/hepta-paper/state-backup-authority/process-config.json

# Strong declared-capability profile. Missing or weaker values must keep
# --require-fully-autonomous fail-closed; they are never inferred at runtime.
HEPTA_AUTONOMOUS_RESEARCH_CONTENT_MODE=agent-evidence-bound
HEPTA_DYNAMIC_FORMAL_CLAIMS_ENABLED=1
HEPTA_RESEARCH_AUTHOR_IDENTITY_CONFIG=/etc/hepta-paper/capabilities-public/research-author-identity.json
# Copy the exact configurationHash from the verified identity configuration.
# This out-of-band pin prevents replacing the file together with its embedded
# trust store and a newly self-consistent signature envelope.
HEPTA_RESEARCH_AUTHOR_IDENTITY_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_REVIEWER_PRINCIPAL_POOL_CONFIG=/etc/hepta-paper/capabilities-public/reviewer-principals.json
HEPTA_PRIOR_ART_SERVICE_CONFIG=/etc/hepta-paper/capabilities-public/prior-art-service.json
HEPTA_EXTERNAL_REPLAY_CONFIG=/etc/hepta-paper/capabilities-public/external-replay-service.json
HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG=/etc/hepta-paper/capabilities-public/venue-profiles.json
HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_DESCRIPTOR_CONFIG=/etc/hepta-paper/capabilities-public/submission-portal-descriptor.json
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_CONFIGURATION_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG=/etc/hepta-paper/capabilities-public/submission-metadata.json
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
