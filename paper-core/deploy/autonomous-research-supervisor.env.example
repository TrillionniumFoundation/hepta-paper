# Non-secret deployment policy. Install as
# /etc/hepta-paper/autonomous-research-supervisor.env mode 0600.
HEPTA_PAPER_ASSET_ROOT=/srv/hepta-paper/assets
# This is the only host root permitted in topic-producer datasetMounts[].source
# entries. The profile stores exact absolute paths and startup resolves them.
HEPTA_AUTONOMOUS_RESEARCH_DATASET_ROOT=/srv/hepta-paper/datasets
HEPTA_PAPER_RUNTIME_ROOT=/var/lib/hepta-paper/runtime
# Compatibility material is externalized and read-only.  It is never resolved
# from a sibling of /opt/hepta-paper; the migration/retirement gates may use
# this root only for a pinned legacy reference snapshot.
PAPER_FACTORY_LEGACY_ROOT=/var/lib/hepta-paper/legacy-reference
HEPTA_AUTONOMOUS_RESEARCH_INTAKE_CONFIG=/etc/hepta-paper/intake/config.json
HEPTA_AUTONOMOUS_RESEARCH_TOPIC_PRODUCER_PROFILE=/etc/hepta-paper/intake/topic-producer-profile.json
HEPTA_SUPERVISOR_POLL_MS=5000
HEPTA_SUPERVISOR_INSTANCE_LEASE_MS=900000
HEPTA_SUPERVISOR_INSTANCE_HEARTBEAT_MS=30000
HEPTA_SUPERVISOR_MAXIMUM_DISPATCHES=256
HEPTA_SUPERVISOR_MAXIMUM_LIFECYCLE_COST_USD=150
HEPTA_SUPERVISOR_MAXIMUM_LIFETIME_MS=604800000
HEPTA_SUPERVISOR_QUALIFICATION_ACTION_SAFETY_MARGIN_MS=900000
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_CONFIG=/etc/hepta-paper/runtime-reproducibility/process-config.json
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_IDENTITY_HASH
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_MAXIMUM_REFRESH_ATTEMPTS_PER_EPOCH=4
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_MAXIMUM_REFRESH_COST_USD_PER_EPOCH=REPLACE_WITH_FIXED_EPOCH_BUDGET_USD
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_REFRESH_RENEWAL_LEAD_MS=REPLACE_WITH_CONFIG_MINIMUM_LEAD_PLUS_BACKOFF_MS
# Qualification and runtime receipts must cover the remaining campaign wall
# budget plus these non-resettable safety margins before any resume dispatch.
HEPTA_RUNTIME_IMAGE_REPRODUCIBILITY_REFRESH_ACTION_SAFETY_MARGIN_MS=900000

# Both roles inherit the model from this shared CODEX_HOME/config.toml. Mirror
# the local main-agent CODEX_HOME into a service-owned private root without
# copying secrets into this env file. The runtime deliberately omits --model.
# Scientific review independence comes from fresh ephemeral sessions, no
# context inheritance, read-only review and hash-bound frozen artifacts.
HEPTA_RESEARCH_AUTHOR_CODEX_HOME=/etc/hepta-paper/credentials/main-agent-codex-home
HEPTA_FORMAL_REVIEW_CODEX_HOME=/etc/hepta-paper/credentials/main-agent-codex-home
HEPTA_AUTONOMOUS_EXTERNAL_QUALIFICATION_CONFIG=/etc/hepta-paper/qualification/process-config.json
# Either an external HSM/KMS command backend or the bundled dedicated-UID
# Unix-socket backend. The latter protects against the research runtime UID but
# does not claim hardware protection or root/hypervisor rollback resistance.
HEPTA_RESEARCH_EXECUTION_RELEASE_ATTESTOR_CONFIG=/etc/hepta-paper/release-attestor/release-attestor.json
HEPTA_RESEARCH_EXECUTION_RELEASE_ATTESTOR_CONFIG_HASH=REPLACE_WITH_SHA256_RESOLVED_CONFIGURATION_IDENTITY_HASH
# Public registry of externally signed production qualification configurations
# for the three bundled numerical reference candidates. It contains paths and
# hashes only; signer private keys and provider credentials remain external.
HEPTA_ADVANCED_NUMERICAL_PLUGIN_QUALIFICATION_REGISTRY=/etc/hepta-paper/capabilities-public/advanced-numerical-reference-qualifications.json
HEPTA_ADVANCED_NUMERICAL_PLUGIN_QUALIFICATION_REGISTRY_HASH=REPLACE_WITH_SHA256_REGISTRY_FILE_HASH
# Public-trust and pinned-client configurations for the transaction-time
# reserve/apply/finalize authority and whole-state backup authority. These
# files may reference the bundled dedicated-UID Unix-socket client or a remote
# broker client, but must never contain private keys or inline credentials.
HEPTA_AUTONOMOUS_RESEARCH_ONLINE_MUTATION_AUTHORITY_PROCESS_CONFIG=/etc/hepta-paper/online-mutation-authority/process-config.json
HEPTA_AUTONOMOUS_RESEARCH_ONLINE_MUTATION_AUTHORITY_CONFIG=/etc/hepta-paper/online-mutation-authority/authority-config.json
HEPTA_AUTONOMOUS_SUBMISSION_HANDOFF_MUTATION_AUTHORITY_PROCESS_CONFIG=/etc/hepta-paper/submission-handoff-authority/process-config.json
HEPTA_AUTONOMOUS_RESEARCH_STATE_BACKUP_AUTHORITY_CONFIG=/etc/hepta-paper/state-backup-authority/process-config.json

# Strong declared-capability profile. Missing or weaker values must keep
# --require-fully-autonomous fail-closed; they are never inferred at runtime.
HEPTA_AUTONOMOUS_RESEARCH_CONTENT_MODE=agent-evidence-bound
HEPTA_DYNAMIC_FORMAL_CLAIMS_ENABLED=1
ELAN_HOME=/opt/hepta-paper/elan
HEPTA_FORMAL_SANDBOX_RUNTIME_CONFIG=/etc/hepta-paper/formal/formal-sandbox-runtime.json
HEPTA_FORMAL_SANDBOX_RUNTIME_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_DYNAMIC_FORMAL_PROJECT_ROOT=/srv/hepta-paper/formal/mathlib-project
HEPTA_DYNAMIC_FORMAL_PROJECT_SCOPE_ROOT=/srv/hepta-paper/formal
HEPTA_DYNAMIC_FORMAL_PROJECT_CLOSURE_HASH=sha256:64b07e1b11ec2f87168612b964d84e350ab9e6e88129397a21694689b24f8412
HEPTA_DYNAMIC_FORMAL_PROJECT_PROBE=HeptaMathlibReadiness.lean
HEPTA_PRODUCTION_MATHLIB_BUILD_AUTHORITY_CONFIG=/run/hepta-authority/production-mathlib-build-authority.json
HEPTA_PRODUCTION_MATHLIB_BUILD_AUTHORITY_CONFIGURATION_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
# Establish or renew the canonical 24-hour probe receipt with the explicit
# automation-status --live-formal-sandbox-probe action. Ordinary status and
# resident startup only validate that receipt against the current identities.
# Full production requires a short-lived, externally signed provider/platform
# author identity and its out-of-band configuration pin. Bounded local runs may
# omit both and use the fresh-ephemeral author session identity instead.
HEPTA_RESEARCH_AUTHOR_IDENTITY_CONFIG=/etc/hepta-paper/capabilities-public/research-author-identity.json
HEPTA_RESEARCH_AUTHOR_IDENTITY_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
# A signed external reviewer pool is an optional stronger compliance mode.
# HEPTA_REVIEWER_PRINCIPAL_POOL_CONFIG=/etc/hepta-paper/capabilities-public/reviewer-principals.json
# Version-2 pool signer/executor token variables are unique *_FILE names in the
# public configuration. Set each to its owner-only file beneath the plan-bound
# reviewer-service credential root; never place token bytes in this public file.
# Example:
# HEPTA_REVIEWER_01_SIGNER_TOKEN_FILE=/run/credentials/hepta-reviewers/HEPTA_REVIEWER_01_SIGNER_TOKEN_FILE
# HEPTA_REVIEWER_01_EXECUTOR_TOKEN_FILE=/run/credentials/hepta-reviewers/HEPTA_REVIEWER_01_EXECUTOR_TOKEN_FILE
HEPTA_PRIOR_ART_SERVICE_CONFIG=/etc/hepta-paper/capabilities-public/prior-art-service.json
HEPTA_PRIOR_ART_SERVICE_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_EXTERNAL_REPLAY_CONFIG=/etc/hepta-paper/capabilities-public/external-replay-service.json
HEPTA_EXTERNAL_REPLAY_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG=/etc/hepta-paper/capabilities-public/venue-profiles.json
HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_DESCRIPTOR_CONFIG=/etc/hepta-paper/capabilities-public/submission-portal-descriptor.json
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_CONFIGURATION_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_DESCRIPTOR_HASH=REPLACE_WITH_SHA256_PUBLIC_DESCRIPTOR_HASH
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG=/etc/hepta-paper/capabilities-public/submission-metadata.json
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
