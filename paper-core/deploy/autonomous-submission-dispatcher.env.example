# Non-secret dispatcher policy. Install as
# /etc/hepta-paper/autonomous-submission-dispatcher.env mode 0600.
HEPTA_PAPER_ASSET_ROOT=/srv/hepta-paper/assets
HEPTA_PAPER_RUNTIME_ROOT=/var/lib/hepta-paper/runtime
HEPTA_SUBMISSION_DISPATCHER_POLL_MS=30000
HEPTA_SUBMISSION_DISPATCHER_LIMIT=100

# The complete endpoint/token-variable configuration is private to the
# dispatcher principal. The descriptor is public and is byte-for-byte checked
# against the complete configuration before any portal adapter is created.
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_CONFIG=/etc/hepta-paper/submission-portal/config.json
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_DESCRIPTOR_CONFIG=/etc/hepta-paper/capabilities-public/submission-portal-descriptor.json
HEPTA_AUTONOMOUS_SUBMISSION_PORTAL_CONFIGURATION_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_SUBMISSION_DISPATCHER_IDENTITY_CONFIG_PATH=/etc/hepta-paper/capabilities-public/submission-dispatcher-identity.json
HEPTA_SUBMISSION_DISPATCHER_CYCLE_SIGNING_CONFIG=/etc/hepta-paper/submission-dispatcher-signer/config.json

HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG=/etc/hepta-paper/capabilities-public/venue-profiles.json
HEPTA_AUTONOMOUS_VENUE_PROFILE_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG=/etc/hepta-paper/capabilities-public/submission-metadata.json
HEPTA_AUTONOMOUS_SUBMISSION_METADATA_CONFIG_HASH=REPLACE_WITH_SHA256_CONFIGURATION_HASH
HEPTA_RESEARCH_EXECUTION_RELEASE_ATTESTOR_CONFIG=/etc/hepta-paper/release-attestor/config.json
# This process configuration is scoped to the single submission-handoff
# database instance. It must not authorize any native research database.
HEPTA_AUTONOMOUS_SUBMISSION_HANDOFF_MUTATION_AUTHORITY_PROCESS_CONFIG=/etc/hepta-paper/submission-handoff-authority/process-config.json

# Put the exact token environment variable named by config.json in the separate
# root-owned 0600 autonomous-submission-dispatcher.secrets.env file. Never add
# that file to autonomous-research-supervisor.service.
