[Unit]
Description=Hepta Paper dedicated-UID release attestor
Requires=hepta-immutable-release-recovery.service
After=hepta-immutable-release-recovery.service
After=local-fs.target
Before=hepta-paper-release-attestor-probe.service autonomous-research-supervisor.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=hepta-release-attestor
Group=hepta-paper
WorkingDirectory=/opt/hepta-paper
RuntimeDirectory=hepta-paper-release-attestor
RuntimeDirectoryMode=0750
StateDirectory=hepta-paper-release-attestor
StateDirectoryMode=0700
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node paper-core/bin/hepta-paper-release-attestor-daemon.mjs --configuration /etc/hepta-paper/release-attestor/signer-daemon.json
Restart=always
RestartSec=2s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/hepta-paper /etc/hepta-paper/release-attestor
ReadWritePaths=/run/hepta-paper-release-attestor /var/lib/hepta-paper-release-attestor
UMask=0007

[Install]
WantedBy=multi-user.target
