      "execute": { "command": "generic-domain-capability-evidence", "arguments": ["--action", "converge", "--paper-id", "strict-acceptance-production-paper"], "environmentReferences": { "@profile": "readiness" }, "assertions": [{ "path": "/ready", "equals": true }, { "path": "/snapshotCurrent", "equals": true }, { "path": "/paperId", "equals": "strict-acceptance-production-paper" }] },
      "verify": { "command": "generic-domain-capability-evidence", "arguments": ["--action", "status", "--paper-id", "strict-acceptance-production-paper"], "environmentReferences": { "@profile": "readiness" }, "assertions": [{ "path": "/ready", "equals": true }, { "path": "/paperBound", "equals": true }, { "path": "/snapshotCurrent", "equals": true }, { "path": "/paperId", "equals": "strict-acceptance-production-paper" }] }
