      "verify": { "command": "automation-status", "arguments": [], "environmentReferences": { "@profile": "readiness" }, "assertions": [{ "path": "/autonomousStateDatabaseInventoryReady", "equals": true }, { "path": "/autonomousStateOnlineAntiRollbackReady", "equals": true }] }
