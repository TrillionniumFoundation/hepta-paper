      "execute": { "command": "autonomous-state-backup", "arguments": ["--action", "restore-drill", "--authority-config", "/run/hepta/backup-restore-authority.json", "--bundle", "/var/lib/hepta-paper/backups/strict-acceptance-bundle"], "environmentReferences": {}, "assertions": [{ "path": "/status", "equals": "autonomous_research_state_restore_drill_passed" }] },
