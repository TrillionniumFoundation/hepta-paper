    "environmentReferences": { "@profile": "readiness" },
    "assertions": [{ "path": "/fullyAutonomousResearchSystemStatus", "equals": "generic_domain_autonomous_research_system_ready" }, { "path": "/fullResearchQualification/paperId", "equals": "strict-acceptance-golden-paper" }]
