[Unit]
Description=Periodically revalidate Hepta Paper strict full-auto acceptance
Requires=hepta-immutable-release-recovery.service
After=hepta-immutable-release-recovery.service

[Timer]
OnBootSec=2min
OnUnitInactiveSec=5min
AccuracySec=15s
Persistent=true
Unit=strict-full-auto-acceptance.service

[Install]
WantedBy=timers.target
